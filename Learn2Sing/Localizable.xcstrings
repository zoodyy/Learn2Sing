    "Focus on keeping your lips flexible and your larynx low." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte darauf, die Lippen locker und den Kehlkopf tief zu halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concéntrate en mantener los labios flexibles y la laringe baja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veillez à garder les lèvres souples et le larynx bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrati sul mantenere le labbra flessibili e la laringe bassa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唇を柔らかく保ち、喉頭を低く保つことに集中します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입술을 유연하게, 후두는 낮게 유지하는 데 집중하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let erop dat je lippen soepel blijven en je strottenhoofd laag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skup się na utrzymaniu elastycznych warg i niskiej krtani."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentre-se em manter os lábios flexíveis e a laringe baixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старайтесь держать губы подвижными, а гортань — низко."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokusera på att hålla läpparna följsamma och struphuvudet lågt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dudaklarınızı esnek ve gırtlağınızı aşağıda tutmaya odaklanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注于保持嘴唇灵活、喉头放低。"
          }
        }
      }
    },
    "Focus on smooth jaw movement and keep it free of tension." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte auf eine geschmeidige Kieferbewegung und halte ihn frei von Spannung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Céntrate en un movimiento suave de la mandíbula y mantenla sin tensión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrez-vous sur un mouvement souple de la mâchoire et gardez-la sans tension."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrati su un movimento fluido della mascella e mantienila priva di tensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あごをなめらかに動かすことに集中し、力みを入れないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "턱을 부드럽게 움직이는 데 집중하고 긴장을 주지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op een soepele kaakbeweging en houd je kaak spanningsvrij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skup się na płynnym ruchu szczęki i utrzymuj ją bez napięcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentre-se em um movimento suave do maxilar e mantenha-o sem tensão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следите за плавным движением челюсти и не допускайте в ней напряжения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokusera på en mjuk käkrörelse och håll käken fri från spänning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çenenizin akıcı hareketine odaklanın ve gergin olmasına izin vermeyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注于下颌的顺畅活动，并保持没有紧张感。"
          }
        }
      }
    },
