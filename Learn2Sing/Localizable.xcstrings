            "state" : "translated",
            "value" : "Загружает файл MP3 или WAV с одним звуком, которым будут играть ноты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laddar upp en MP3- eller WAV-fil med ett enda ljud att spela tonerna med."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notaların çalınacağı tek bir ses içeren MP3 veya WAV dosyası yükler."
          }
        },
        "zh-Hans" : {
