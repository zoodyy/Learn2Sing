    "Move your jaw freely on the \"Yum\" and maintain the relaxed feeling on the \"Ya.\"" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege den Kiefer beim „Yum“ frei und behalte das entspannte Gefühl beim „Ya“ bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la mandíbula con libertad en el «Yum» y mantén esa sensación relajada en el «Ya»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bougez librement la mâchoire sur le « Yum » et gardez cette sensation de détente sur le « Ya »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muovi liberamente la mascella sul “Yum” e mantieni la sensazione di rilassamento sul “Ya”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Yum」ではあごを自由に動かし、「Ya」でもそのリラックスした感覚を保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Yum”에서는 턱을 자유롭게 움직이고, “Ya”에서도 그 편안한 느낌을 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweeg je kaak vrij bij de ‘Yum’ en houd dat ontspannen gevoel vast bij de ‘Ya’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poruszaj swobodnie szczęką na „Yum” i utrzymaj to rozluźnione odczucie na „Ya”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova o maxilar livremente no “Yum” e mantenha a sensação relaxada no “Ya”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свободно двигайте челюстью на «Yum» и сохраняйте это расслабленное ощущение на «Ya»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rör käken fritt på ”Yum” och behåll den avslappnade känslan på ”Ya”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Yum” hecesinde çenenizi serbestçe hareket ettirin ve “Ya” hecesinde bu gevşek hissi koruyun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“Yum”上自由活动下颌，并在“Ya”上保持这种放松的感觉。"
          }
        }
      }
    },
