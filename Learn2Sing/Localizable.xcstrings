    "Swaps the drag handles for delete buttons, to take exercises off this list. They stay in your library." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tauscht die Ziehgriffe gegen Löschknöpfe, um Übungen aus dieser Liste zu nehmen. In deiner Bibliothek bleiben sie erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia las asas de arrastre por botones de borrar, para sacar ejercicios de esta lista. Siguen en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace les poignées de déplacement par des boutons de suppression, pour retirer des exercices de cette liste. Ils restent dans votre bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce le maniglie di trascinamento con pulsanti di eliminazione, per togliere esercizi da questo elenco. Restano nella tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグ用のハンドルを削除ボタンに切り替え、このリストからエクササイズを外せるようにします。ライブラリには残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그 손잡이를 삭제 버튼으로 바꿔 이 목록에서 연습을 뺄 수 있게 합니다. 라이브러리에는 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervangt de sleepgrepen door verwijderknoppen om oefeningen van deze lijst te halen. Ze blijven in je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamienia uchwyty przeciągania na przyciski usuwania, aby zdjąć ćwiczenia z tej listy. W bibliotece zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troca as alças de arrastar por botões de excluir, para tirar exercícios desta lista. Eles continuam na sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет ручки перетаскивания на кнопки удаления, чтобы убрать упражнения из этого списка. В библиотеке они остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byter draghandtagen mot raderaknappar, för att ta bort övningar från den här listan. De blir kvar i ditt bibliotek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu listeden egzersiz çıkarmak için sürükleme tutamaklarını silme düğmeleriyle değiştirir. Egzersizler kitaplığınızda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把拖动手柄换成删除按钮，用来把练习移出这个列表。它们仍留在你的库中。"
          }
        }
      }
    },
    "Swaps the drag handles for delete buttons. Deleting a category keeps its exercises and moves them to “No Category”." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tauscht die Ziehgriffe gegen Löschknöpfe. Beim Löschen einer Kategorie bleiben ihre Übungen erhalten und wandern zu „Ohne Kategorie“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia las asas de arrastre por botones de borrar. Al borrar una categoría, sus ejercicios se conservan y pasan a «Sin categoría»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace les poignées de déplacement par des boutons de suppression. Supprimer une catégorie conserve ses exercices et les déplace vers « Sans catégorie »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce le maniglie di trascinamento con pulsanti di eliminazione. Eliminando una categoria i suoi esercizi restano e passano a “Senza categoria”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグ用のハンドルを削除ボタンに切り替えます。カテゴリを削除しても、そのエクササイズは残り「カテゴリなし」に移ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그 손잡이를 삭제 버튼으로 바꿉니다. 분류를 지워도 그 안의 연습은 남아 “분류 없음”으로 옮겨집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervangt de sleepgrepen door verwijderknoppen. Een categorie verwijderen behoudt haar oefeningen en verplaatst ze naar ‘Geen categorie’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamienia uchwyty przeciągania na przyciski usuwania. Usunięcie kategorii zachowuje jej ćwiczenia i przenosi je do „Bez kategorii”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troca as alças de arrastar por botões de excluir. Excluir uma categoria mantém seus exercícios e os move para “Sem categoria”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет ручки перетаскивания на кнопки удаления. При удалении категории её упражнения сохраняются и переходят в «Без категории»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byter draghandtagen mot raderaknappar. Att radera en kategori behåller dess övningar och flyttar dem till ”Ingen kategori”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürükleme tutamaklarını silme düğmeleriyle değiştirir. Bir kategoriyi silmek egzersizlerini korur ve onları “Kategorisiz” bölümüne taşır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把拖动手柄换成删除按钮。删除分类不会删掉其中的练习，它们会移到“未分类”。"
          }
        }
      }
    },
