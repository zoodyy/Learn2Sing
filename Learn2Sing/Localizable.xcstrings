        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’où vient cette leçon et sous quelle licence elle est partagée. Touchez un lien pour l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
