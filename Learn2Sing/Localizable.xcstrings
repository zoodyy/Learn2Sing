    "Empties the Home tab's “Favorites” list. The exercises in it are kept." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُفرغ قائمة «المفضلة» في تبويب الرئيسية. تبقى التمارين الموجودة فيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leert die Liste „Favoriten“ im Start-Tab. Die darin enthaltenen Übungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía la lista «Favoritos» de la pestaña Inicio. Los ejercicios que contiene se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vide la liste « Favoris » de l’onglet Accueil. Les exercices qu’elle contient sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svuota l’elenco “Preferiti” della scheda Home. Gli esercizi al suo interno vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームタブの「お気に入り」リストを空にします。その中のエクササイズは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 탭의 “즐겨찾기” 목록을 비웁니다. 목록에 있던 연습은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt de lijst ‘Favorieten’ op het tabblad Start leeg. De oefeningen erin blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opróżnia listę „Ulubione” na karcie Start. Ćwiczenia z niej pozostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esvazia a lista “Favoritos” da aba Início. Os exercícios nela são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очищает список «Избранное» на вкладке «Главная». Упражнения в нём остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tömmer listan ”Favoriter” på fliken Hem. Övningarna i den behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa sekmesindeki “Favoriler” listesini boşaltır. İçindeki egzersizler kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清空“首页”标签的“收藏”列表。其中的练习会保留。"
          }
        }
      }
    },
    "Enter text to place on the grid." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل نصًا لوضعه على الشبكة"
          }
        },
        "de" : {
          "stringUnit" : {
