    },
    "Ear Training" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدريب الأذن"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehörbildung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento auditivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formation de l’oreille"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Educazione dell’orecchio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耳のトレーニング"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "청음 훈련"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehoortraining"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kształcenie słuchu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treinamento auditivo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Развитие слуха"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehörsträning"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulak eğitimi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "练耳"
          }
        }
      }
    },
    "Ear training is the practice of learning to recognize the building blocks of music by hearing alone: pitches, intervals, melodies, chords and rhythms. In a way it is the reverse of reading music: instead of turning notes on a page into sound, you work out what you are hearing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدريب الأذن هو التمرّن على التعرّف على مكوّنات الموسيقى الأساسية بالسمع وحده: درجات الصوت والفواصل والألحان والتآلفات والإيقاعات. وهو بمعنى ما عكس قراءة النوتة: فبدل أن تحوّل النغمات المكتوبة إلى صوت، تستنتج ما الذي تسمعه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehörbildung heißt, die Bausteine der Musik allein durch Hören erkennen zu lernen: Tonhöhen, Intervalle, Melodien, Akkorde und Rhythmen. Sie ist gewissermaßen das Gegenteil vom Notenlesen: Statt Noten auf dem Papier in Klang zu verwandeln, findest du heraus, was du hörst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento auditivo consiste en aprender a reconocer solo de oído los elementos básicos de la música: alturas, intervalos, melodías, acordes y ritmos. En cierto modo es lo contrario de leer música: en lugar de convertir las notas de una partitura en sonido, descifras lo que estás oyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La formation de l’oreille consiste à apprendre à reconnaître à l’oreille seule les éléments de base de la musique : hauteurs, intervalles, mélodies, accords et rythmes. C’est en quelque sorte l’inverse de la lecture musicale : au lieu de transformer des notes écrites en son, vous déterminez ce que vous entendez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’educazione dell’orecchio consiste nell’imparare a riconoscere solo ascoltando gli elementi di base della musica: altezze, intervalli, melodie, accordi e ritmi. In un certo senso è l’opposto della lettura musicale: invece di trasformare le note scritte in suono, capisci che cosa stai ascoltando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耳のトレーニングとは、音の高さ、音程、メロディー、和音、リズムといった音楽の構成要素を、耳だけで聞き分けられるようにする練習です。ある意味で楽譜を読むことの逆で、書かれた音符を音にするのではなく、聞こえている音が何かを読み解きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "청음 훈련은 음높이, 음정, 멜로디, 화음, 리듬 같은 음악의 기본 요소를 귀로만 알아듣도록 배우는 연습입니다. 어떤 의미에서는 악보 읽기의 반대입니다. 종이 위의 음표를 소리로 바꾸는 대신, 들리는 소리가 무엇인지 알아냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehoortraining is het leren herkennen van de bouwstenen van muziek puur op het gehoor: toonhoogtes, intervallen, melodieën, akkoorden en ritmes. In zekere zin is het het omgekeerde van noten lezen: in plaats van noten op papier in klank om te zetten, zoek je uit wat je hoort."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kształcenie słuchu to nauka rozpoznawania samym słuchem podstawowych elementów muzyki: wysokości dźwięków, interwałów, melodii, akordów i rytmów. W pewnym sensie to odwrotność czytania nut: zamiast zamieniać zapisane nuty w dźwięk, rozpoznajesz, co słyszysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O treinamento auditivo é a prática de aprender a reconhecer só de ouvido os elementos básicos da música: alturas, intervalos, melodias, acordes e ritmos. De certa forma, é o inverso de ler partitura: em vez de transformar notas escritas em som, você descobre o que está ouvindo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Развитие слуха означает умение распознавать на слух основные элементы музыки: высоту звуков, интервалы, мелодии, аккорды и ритмы. В каком-то смысле это противоположность чтению нот: вы не превращаете записанные ноты в звук, а разбираетесь в том, что слышите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehörsträning innebär att lära sig känna igen musikens byggstenar enbart genom att lyssna: tonhöjder, intervall, melodier, ackord och rytmer. På sätt och vis är det motsatsen till att läsa noter: i stället för att göra om noter på papper till ljud listar du ut vad du hör."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulak eğitimi, müziğin yapı taşlarını yalnızca duyarak tanımayı öğrenme çalışmasıdır: perdeler, aralıklar, melodiler, akorlar ve ritimler. Bir bakıma nota okumanın tersidir: kâğıttaki notaları sese dönüştürmek yerine duyduğunuzu çözersiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "练耳是指学习仅凭听觉辨认音乐的基本要素：音高、音程、旋律、和弦和节奏。某种意义上，它与读谱正好相反：不是把纸上的音符变成声音，而是弄清楚你听到的是什么。"
          }
        }
      }
    },
    "Easiest for Me" : {
