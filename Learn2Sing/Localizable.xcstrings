    "Begins the exercise. Sing along with the notes as they scroll past, and you get a score at the end." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ التمرين. غنِّ مع النغمات أثناء مرورها، وستحصل على نتيجة في النهاية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet die Übung. Singe die Noten mit, während sie vorbeiziehen, und am Ende bekommst du eine Bewertung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza el ejercicio. Canta las notas mientras pasan y al final recibirás una puntuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre l’exercice. Chantez les notes à mesure qu’elles défilent : un score s’affiche à la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia l’esercizio. Canta le note mentre scorrono e alla fine ricevi un punteggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクササイズを始めます。流れてくる音符に合わせて歌うと、最後にスコアが出ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습을 시작합니다. 흘러가는 음에 맞춰 노래하면 끝에 점수가 나옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start de oefening. Zing mee met de noten terwijl ze voorbijkomen; aan het eind krijg je een score."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoczyna ćwiczenie. Śpiewaj nuty, gdy przesuwają się po ekranie, a na końcu dostaniesz wynik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começa o exercício. Cante junto com as notas enquanto elas passam e você recebe uma pontuação no fim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинает упражнение. Пойте ноты, пока они движутся, а в конце вы получите оценку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startar övningen. Sjung med tonerna medan de rullar förbi, så får du poäng på slutet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egzersizi başlatır. Notalar akıp geçerken onlarla birlikte söyleyin; sonunda bir puan alırsınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始练习。跟着滚动的音符演唱，结束时会给出评分。"
          }
        }
      }
    },
