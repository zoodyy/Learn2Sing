        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연습을 부르지 않고 건너뛰어 대기열의 다음 연습으로 갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaat deze oefening over en gaat door naar de volgende in de rij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomija to ćwiczenie i przechodzi do następnego w kolejce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
