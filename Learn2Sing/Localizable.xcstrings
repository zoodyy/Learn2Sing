    "Sets the app's appearance. “System” matches your device's light or dark setting." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt das Erscheinungsbild der App fest. „System“ folgt der Hell-/Dunkel-Einstellung deines Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define la apariencia de la app. «Sistema» sigue el ajuste claro u oscuro de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit l’apparence de l’app. « Système » suit le réglage clair ou sombre de votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta l’aspetto dell’app. “Sistema” segue l’impostazione chiara o scura del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの外観を設定します。「システム」は端末のライト／ダーク設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 모양을 설정합니다. “시스템”은 기기의 라이트/다크 설정을 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt het uiterlijk van de app. ‘Systeem’ volgt de licht- of donkerinstelling van je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia wygląd aplikacji. „Systemowy” podąża za jasnym lub ciemnym ustawieniem urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define a aparência do app. “Sistema” segue a configuração clara ou escura do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт оформление приложения. «Системное» следует светлой или тёмной теме устройства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anger appens utseende. ”System” följer enhetens ljusa eller mörka inställning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın görünümünü belirler. “Sistem”, cihazınızın açık veya koyu ayarını izler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置应用的外观。“系统”会跟随设备的浅色或深色设置。"
          }
        }
      }
    },
    "Sets the colour of the pitch names (C4, A3 …) down the left-hand side of the playback screen." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt die Farbe der Tonnamen (C4, A3 …) am linken Rand des Wiedergabebildschirms fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define el color de los nombres de notas (C4, A3 …) en el lado izquierdo de la pantalla de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit la couleur des noms de notes (C4, A3 …) sur le côté gauche de l’écran de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta il colore dei nomi delle note (C4, A3 …) sul lato sinistro della schermata di riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生画面の左側に並ぶ音名（C4、A3 …）の色を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 화면 왼쪽에 표시되는 음이름(C4, A3 …)의 색을 설정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt de kleur van de notennamen (C4, A3 …) langs de linkerkant van het afspeelscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia kolor nazw nut (C4, A3 …) wzdłuż lewej krawędzi ekranu odtwarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define a cor dos nomes das notas (C4, A3 …) no lado esquerdo da tela de reprodução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт цвет названий нот (C4, A3 …) вдоль левого края экрана воспроизведения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anger färgen på tonnamnen (C4, A3 …) längs uppspelningsskärmens vänstra kant."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalma ekranının sol tarafındaki nota adlarının (C4, A3 …) rengini belirler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置播放界面左侧音名（C4、A3 …）的颜色。"
          }
        }
      }
    },
    "Sets the colour of the small note pattern drawn beside each exercise in the lists." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt die Farbe des kleinen Notenmusters fest, das in den Listen neben jeder Übung gezeichnet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define el color del pequeño patrón de notas que aparece junto a cada ejercicio en las listas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit la couleur du petit motif de notes affiché à côté de chaque exercice dans les listes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta il colore del piccolo motivo di note disegnato accanto a ogni esercizio negli elenchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストで各エクササイズの横に描かれる小さな音符パターンの色を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록에서 각 연습 옆에 그려지는 작은 음표 패턴의 색을 설정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt de kleur van het kleine notenpatroon naast elke oefening in de lijsten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia kolor małego wzoru nut rysowanego obok każdego ćwiczenia na listach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
