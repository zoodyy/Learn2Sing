    "Hides the Home, Exercises, Community and Settings tabs at the bottom of the screen while an exercise plays." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخفي تبويبات الرئيسية والتمارين والمجتمع والإعدادات أسفل الشاشة أثناء تشغيل تمرين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die Tabs Start, Übungen, Community und Einstellungen am unteren Bildschirmrand aus, während eine Übung läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta las pestañas Inicio, Ejercicios, Comunidad y Ajustes en la parte inferior mientras se reproduce un ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque les onglets Accueil, Exercices, Communauté et Réglages en bas de l’écran pendant la lecture d’un exercice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde le schede Home, Esercizi, Comunità e Impostazioni in fondo allo schermo mentre un esercizio è in riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクササイズの再生中、画面下部のホーム・エクササイズ・コミュニティ・設定のタブを隠します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습이 재생되는 동안 화면 하단의 홈, 연습, 커뮤니티, 설정 탭을 숨깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt de tabbladen Start, Oefeningen, Community en Instellingen onderaan het scherm terwijl een oefening speelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa karty Start, Ćwiczenia, Społeczność i Ustawienia na dole ekranu podczas odtwarzania ćwiczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta as abas Início, Exercícios, Comunidade e Ajustes na parte inferior da tela enquanto um exercício toca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает вкладки «Главная», «Упражнения», «Сообщество» и «Настройки» внизу экрана во время упражнения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer flikarna Hem, Övningar, Community och Inställningar längst ned på skärmen medan en övning spelas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir egzersiz çalarken ekranın altındaki Ana Sayfa, Egzersizler, Topluluk ve Ayarlar sekmelerini gizler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
