    "Choose the sound that plays the notes, or upload your own." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den Klang, mit dem die Noten gespielt werden, oder lade einen eigenen hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el sonido con el que suenan las notas, o sube el tuyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le son qui joue les notes, ou importez le vôtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il suono con cui vengono suonate le note, oppure caricane uno tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音を鳴らす楽器を選ぶか、自分の音源をアップロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음을 재생할 소리를 선택하거나 직접 업로드하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies het geluid waarmee de noten klinken, of upload je eigen geluid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz dźwięk, którym odtwarzane są nuty, lub prześlij własny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o som que toca as notas ou envie o seu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите звук, которым проигрываются ноты, или загрузите свой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ljudet som spelar noterna, eller ladda upp ett eget."
          }
        },
