          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje övning du själv skapat raderas, tillsammans med dess MIDI-mönster och poäng."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
