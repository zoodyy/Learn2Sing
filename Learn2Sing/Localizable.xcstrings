    "How your picture looks to everyone else. Tap it to move and zoom it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sieht dein Bild für alle anderen aus. Tippe darauf, um es zu verschieben und zu zoomen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así se ve tu foto para los demás. Tócala para moverla y ampliarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
