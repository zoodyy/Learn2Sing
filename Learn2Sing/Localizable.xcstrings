    "Narrows the list to the exercises you have liked, or to the ones you have not. The button is filled in while a filter is on." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur die Übungen, die du magst, oder nur die anderen. Der Knopf ist ausgefüllt, solange ein Filter aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la lista a los ejercicios que te gustan, o a los que no. El botón se rellena mientras hay un filtro activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la liste aux exercices que vous aimez, ou à ceux que vous n’aimez pas. Le bouton est rempli tant qu’un filtre est actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe l’elenco agli esercizi a cui hai messo mi piace, o a quelli a cui non l’hai messo. Il pulsante è pieno finché un filtro è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「いいね」したエクササイズだけ、またはそれ以外だけに絞り込みます。フィルタが有効な間、ボタンは塗りつぶされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋아요를 누른 연습만, 또는 누르지 않은 연습만 보여줍니다. 필터가 켜져 있는 동안 버튼이 채워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt de lijst tot de oefeningen die je leuk vindt, of juist tot de andere. De knop is gevuld zolang er een filter aanstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawęża listę do ćwiczeń, które polubiłeś, albo do pozostałych. Przycisk jest wypełniony, dopóki filtr działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe a lista aos exercícios que você curtiu, ou aos que não curtiu. O botão fica preenchido enquanto há um filtro ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет в списке только упражнения, которые вам нравятся, или только остальные. Пока фильтр включён, кнопка залита."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsar listan till övningarna du gillat, eller till de andra. Knappen är ifylld så länge ett filter är på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listeyi beğendiğiniz egzersizlerle ya da beğenmediklerinizle sınırlar. Bir filtre açıkken düğme dolu görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只显示你点过赞的练习，或只显示未点赞的。筛选开启时按钮为实心。"
          }
        }
      }
    },
    "Narrows the list to where the exercises came from, or to the ones you have shared. The button is filled in while a filter is on." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schränkt die Liste darauf ein, woher die Übungen stammen, oder auf die von dir geteilten. Der Knopf ist ausgefüllt, solange ein Filter aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la lista según de dónde vienen los ejercicios, o a los que has compartido. El botón se rellena mientras hay un filtro activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la liste selon la provenance des exercices, ou à ceux que vous avez partagés. Le bouton est rempli tant qu’un filtre est actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe l’elenco in base alla provenienza degli esercizi, o a quelli che hai condiviso. Il pulsante è pieno finché un filtro è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクササイズの入手元や、自分が公開したものだけに絞り込みます。フィルタが有効な間、ボタンは塗りつぶされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습의 출처별로, 또는 내가 공유한 것만 보이도록 좁힙니다. 필터가 켜져 있는 동안 버튼이 채워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt de lijst tot waar de oefeningen vandaan komen, of tot die je hebt gedeeld. De knop is gevuld zolang er een filter aanstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawęża listę według tego, skąd pochodzą ćwiczenia, albo do tych, które udostępniłeś. Przycisk jest wypełniony, dopóki filtr działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe a lista conforme a origem dos exercícios, ou aos que você compartilhou. O botão fica preenchido enquanto há um filtro ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
