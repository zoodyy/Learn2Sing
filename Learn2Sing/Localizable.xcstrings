          }
        }
      }
    },
    "The same four-note figure moves up one step at a time. Keep each group even and in tune." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشكل نفسه المكوّن من أربع نغمات يصعد درجة واحدة في كل مرة. أبقِ كل مجموعة متساوية ومضبوطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieselbe Viertonfigur wandert Schritt für Schritt nach oben. Halte jede Gruppe gleichmäßig und sauber."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma figura de cuatro notas sube paso a paso. Mantén cada grupo uniforme y afinado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le même motif de quatre notes monte d’un degré à la fois. Gardez chaque groupe égal et juste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stessa figura di quattro note sale di un grado alla volta. Mantieni ogni gruppo uniforme e intonato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ4音の型が1段ずつ上がっていきます。どのグループも均等に、正しい音程で歌います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 네 음 음형이 한 음씩 올라갑니다. 각 묶음을 고르고 정확한 음정으로 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetzelfde figuurtje van vier noten gaat telkens een stap omhoog. Houd elke groep gelijk en zuiver."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sama czterodźwiękowa figura przesuwa się w górę o jeden stopień. Utrzymuj każdą grupę równą i czystą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mesma figura de quatro notas sobe um grau de cada vez. Mantenha cada grupo uniforme e afinado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна и та же фигура из четырёх нот поднимается на ступень за раз. Каждая группа должна быть ровной и чистой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samma fyrtonsfigur flyttar upp ett steg i taget. Håll varje grupp jämn och ren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı dört notalı figür her seferinde bir basamak yükselir. Her grubu eşit ve doğru perdeden tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一个四音音型每次上移一级。每一组都要均匀、音准。"
          }
        }
      }
    },
