    "“%@” goes back to how it came with the app." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird auf den mitgelieferten Zustand zurückgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» volverá a como venía con la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » revient tel qu’il était fourni avec l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” torna a com’era incluso nell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」がアプリ付属の状態に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 앱에 포함되었던 상태로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ gaat terug naar hoe ze met de app meekwam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” wróci do postaci dołączonej do aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” volta ao estado em que veio com o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» вернётся к встроенному виду."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” återgår till hur den följde med appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” uygulamayla geldiği haline döner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将恢复为应用自带时的状态。"
          }
        }
      }
    },
    "\"%@\" will be deleted. Its exercises stay in your library. This cannot be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird gelöscht. Die enthaltenen Übungen bleiben in deiner Bibliothek. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará «%@». Sus ejercicios permanecerán en tu biblioteca. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimée. Ses exercices restent dans votre bibliothèque. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà eliminata. I suoi esercizi restano nella tua libreria. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を削除します。含まれるエクササイズはライブラリに残ります。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 삭제됩니다. 포함된 연습은 라이브러리에 그대로 남습니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ wordt verwijderd. De oefeningen blijven in je bibliotheek. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” zostanie usunięta. Jej ćwiczenia pozostaną w twojej bibliotece. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” será excluída. Seus exercícios permanecem na sua biblioteca. Isso não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» будет удалена. Её упражнения останутся в вашей библиотеке. Это действие нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” raderas. Dess övningar finns kvar i ditt bibliotek. Det går inte att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” silinecek. İçindeki egzersizler kitaplığınızda kalır. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除“%@”。其中的练习会保留在你的库中。此操作无法撤销。"
          }
        }
      }
    },
    "“Automatic” uses connected earphones (e.g. AirPods) when available, otherwise the phone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ nutzt angeschlossene Kopfhörer (z. B. AirPods), sonst das Telefon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Automático» usa los auriculares conectados (p. ej. AirPods) si los hay; si no, el teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Automatique » utilise les écouteurs connectés (p. ex. AirPods) s’il y en a, sinon le téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automatico” usa gli auricolari collegati (ad es. AirPods) se disponibili, altrimenti il telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」は接続中のイヤフォン（AirPodsなど）があればそれを、なければ本体を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“자동”은 연결된 이어폰(예: AirPods)이 있으면 그것을, 없으면 기기를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Automatisch’ gebruikt aangesloten oordopjes (bijv. AirPods) als die er zijn, anders de telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatycznie” korzysta z podłączonych słuchawek (np. AirPods), a w przeciwnym razie z telefonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automático” usa os fones conectados (por ex. AirPods) quando houver; caso contrário, o telefone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Автоматически» использует подключённые наушники (например, AirPods), иначе — телефон."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Automatiskt” använder anslutna hörlurar (t.ex. AirPods) när de finns, annars telefonen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Otomatik”, bağlı kulaklıkları (ör. AirPods) varsa onları, yoksa telefonu kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会在有已连接耳机（如 AirPods）时使用耳机，否则使用手机。"
          }
        }
      }
    },
    "“Line” draws one continuous line. “Dots” replaces it with a dot in the middle of every pitch." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Linie“ zeichnet eine durchgehende Linie. „Punkte“ ersetzt sie durch je einen Punkt in der Mitte jeder Tonhöhe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Línea» dibuja una línea continua. «Puntos» la sustituye por un punto en el centro de cada nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ligne » trace une ligne continue. « Points » la remplace par un point au milieu de chaque hauteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Linea” disegna una linea continua. “Punti” la sostituisce con un punto al centro di ogni altezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「線」は一本の連続した線を描きます。「点」はそれを各音の中央の点に置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“선”은 하나의 연속된 선을 그립니다. “점”은 각 음 가운데의 점으로 대체합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Lijn’ tekent één doorlopende lijn. ‘Stippen’ vervangt die door een stip midden op elke toonhoogte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Linia” rysuje jedną ciągłą linię. „Kropki” zastępuje ją kropką na środku każdej wysokości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Linha” desenha uma linha contínua. “Pontos” a substitui por um ponto no meio de cada altura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Линия» рисует сплошную линию. «Точки» заменяет её точкой в центре каждой высоты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Linje” ritar en sammanhängande linje. ”Punkter” ersätter den med en punkt mitt på varje tonhöjd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Çizgi” tek bir sürekli çizgi çizer. “Noktalar” bunu her perdenin ortasındaki bir noktayla değiştirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“线条”绘制一条连续的线。“圆点”将其替换为每个音高中央的一个点。"
          }
        }
      }
    },
