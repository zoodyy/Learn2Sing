          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie lekcje znów zostaną oznaczone jako nieukończone, a „Lekcje do czytania” na karcie Start będą polecać od pierwszej lekcji."
          }
