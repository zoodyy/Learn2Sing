        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 사용자의 점수로 계산한 이 연습의 난이도입니다. 별 다섯 개가 가장 어렵습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
