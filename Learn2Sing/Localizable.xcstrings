    "Line your singing up with the notes, then tap Done." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طابِق غناءك مع النغمات، ثم اضغط على «تم»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringe deinen Gesang mit den Noten in Deckung und tippe dann auf „Fertig“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinea tu canto con las notas y luego toca «Listo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alignez votre chant sur les notes, puis touchez « Terminé »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allinea il tuo canto con le note, poi tocca “Fatto”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌をノーツに合わせてから「完了」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노래를 음표에 맞춘 다음 ‘완료’를 누르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg je zang op de noten en tik daarna op ‘Klaar’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasuj swój śpiew do nut, a potem dotknij „Gotowe”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinhe seu canto com as notas e toque em “Concluído”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совместите пение с нотами и нажмите «Готово»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg din sång i linje med noterna och tryck sedan på ”Klar”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarkınızı notalarla hizalayın, sonra “Bitti”ye dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你的歌声与音符对齐，然后点按“完成”。"
          }
        }
      }
    },
    "Listen for the wide step between the sixth and seventh notes, which gives this scale its distinctive sound." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى الخطوة الواسعة بين النغمتين السادسة والسابعة، التي تمنح هذا السلم صوته المميز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte auf den großen Schritt zwischen dem sechsten und siebten Ton, der dieser Tonleiter ihren besonderen Klang gibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fíjate en el paso amplio entre la sexta y la séptima nota, que le da a esta escala su sonido característico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoutez le grand pas entre la sixième et la septième note, qui donne à cette gamme sa couleur particulière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta il passo ampio tra la sesta e la settima nota, che dà a questa scala il suo suono caratteristico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6番目と7番目の音の間の広い音程に耳を傾けます。これがこの音階の独特な響きを生みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여섯 번째와 일곱 번째 음 사이의 넓은 간격에 귀를 기울이세요. 이 간격이 이 음계만의 독특한 소리를 만듭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luister naar de grote stap tussen de zesde en zevende noot, die deze toonladder zijn kenmerkende klank geeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wsłuchaj się w szeroki krok między szóstym a siódmym dźwiękiem, który nadaje tej gamie charakterystyczne brzmienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preste atenção ao passo largo entre a sexta e a sétima nota, que dá a esta escala seu som característico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прислушайтесь к широкому шагу между шестой и седьмой нотами: именно он придаёт этой гамме особое звучание."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyssna efter det stora steget mellan den sjätte och sjunde tonen, som ger skalan dess särpräglade klang."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu diziye kendine özgü sesini veren altıncı ve yedinci notalar arasındaki geniş adıma kulak verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留意第六和第七个音之间的宽音程，正是它赋予了这个音阶独特的声音。"
          }
        }
      }
    },
