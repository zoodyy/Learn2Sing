          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите звук, которым проигрываются ноты, или загрузите свой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ljudet som spelar noterna, eller ladda upp ett eget."
          }
        },
