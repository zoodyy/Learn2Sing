        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 레슨의 출처와 공유 라이선스입니다. 링크를 탭하면 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar deze les vandaan komt en onder welke licentie hij wordt gedeeld. Tik op een link om hem te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skąd pochodzi ta lekcja i na jakiej licencji jest udostępniana. Dotknij linku, aby go otworzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
