    "Hear each note in your head before you sing it and match it exactly. Keep your tone even from bottom to top." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمع كل نغمة في رأسك قبل أن تغنيها وطابقها تمامًا. حافظ على نبرة متساوية من الأسفل إلى الأعلى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör jeden Ton innerlich, bevor du ihn singst, und triff ihn genau. Halte deinen Klang von unten bis oben gleichmäßig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha cada nota en tu cabeza antes de cantarla y afínala con exactitud. Mantén el tono uniforme de abajo arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entendez chaque note dans votre tête avant de la chanter et reproduisez-la exactement. Gardez un timbre égal du bas vers le haut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senti ogni nota nella tua testa prima di cantarla e intonala con precisione. Mantieni il suono uniforme dal basso verso l’alto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌う前に各音を頭の中で聴き、正確に合わせます。低い音から高い音まで音色をそろえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부르기 전에 각 음을 머릿속으로 듣고 정확히 맞추세요. 아래에서 위까지 음색을 고르게 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoor elke noot in je hoofd voordat je hem zingt en zing hem precies zuiver. Houd je klank gelijk van onder tot boven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usłysz każdy dźwięk w głowie, zanim go zaśpiewasz, i traf w niego dokładnie. Utrzymuj równą barwę od dołu do góry."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouça cada nota na cabeça antes de cantá-la e acerte-a exatamente. Mantenha o timbre uniforme de baixo até em cima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слышьте каждую ноту в голове, прежде чем петь её, и попадайте точно. Сохраняйте ровный тембр снизу доверху."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör varje ton inom dig innan du sjunger den och träffa den exakt. Håll klangen jämn från botten till toppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her notayı söylemeden önce kafanızda duyun ve tam olarak tutturun. Tonunuzu aşağıdan yukarıya eşit tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唱之前先在脑中听到每个音，并准确唱准。从低到高保持音色均匀。"
          }
        }
      }
    },
