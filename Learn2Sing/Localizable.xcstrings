          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa o desenvolvedor sobre este perfil se o nome, a foto ou a descrição forem ofensivos ou estiverem fora de lugar aqui. Você escreve o motivo antes de qualquer envio."
          }
        },
        "ru" : {
