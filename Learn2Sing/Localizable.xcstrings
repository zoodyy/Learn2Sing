          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт цвет небольшого рисунка нот рядом с каждым упражнением в списках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anger färgen på det lilla notmönstret som ritas bredvid varje övning i listorna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
