    "The color a note takes on while it is the one being sung." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللون الذي تأخذه النغمة أثناء غنائها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farbe, die eine Note annimmt, solange sie gerade gesungen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color que toma una nota mientras es la que se está cantando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La couleur que prend une note pendant qu’elle est chantée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colore che una nota assume mentre è quella che si sta cantando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのとき歌っている音符が取る色です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 부르고 있는 음이 띠는 색입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kleur die een noot aanneemt terwijl hij gezongen wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolor, jaki przyjmuje nuta, gdy właśnie jest śpiewana."
