    "Round your lips into a small \"Oo\" and restart every note with a gentle \"M\". Don't push for volume." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوّر شفتيك على شكل «Oo» صغيرة وابدأ كل نغمة من جديد بـ «M» لطيفة. لا تضغط لرفع الصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde die Lippen zu einem kleinen „Oo“ und setze jeden Ton mit einem sanften „M“ neu an. Drück nicht auf Lautstärke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redondea los labios en una «Oo» pequeña y empieza cada nota con una «M» suave. No fuerces el volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrondissez les lèvres en un petit « Oo » et relancez chaque note avec un « M » doux. Ne forcez pas sur le volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrotonda le labbra in una piccola “Oo” e riattacca ogni nota con una “M” delicata. Non spingere sul volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唇を小さな「Oo」の形に丸め、どの音もやさしい「M」から始め直します。音量を無理に出さないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입술을 작은 “Oo” 모양으로 둥글게 하고 음마다 부드러운 “M”으로 다시 시작하세요. 음량을 억지로 키우지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak je lippen rond tot een kleine ‘Oo’ en zet elke noot opnieuw in met een zachte ‘M’. Forceer het volume niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaokrąglij wargi w małe „Oo” i zaczynaj każdy dźwięk od delikatnego „M”. Nie forsuj głośności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arredonde os lábios em um “Oo” pequeno e comece cada nota com um “M” suave. Não force o volume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Округлите губы в маленькое «Oo» и начинайте каждую ноту с мягкого «M». Не форсируйте громкость."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runda läpparna till ett litet ”Oo” och börja varje ton med ett mjukt ”M”. Pressa inte fram volym."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dudaklarınızı küçük bir “Oo” şeklinde yuvarlayın ve her notayı yumuşak bir “M” ile yeniden başlatın. Sesi zorlamayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把嘴唇收圆成一个小小的“Oo”，每个音都用轻柔的“M”重新起音。不要用力追求音量。"
          }
        }
      }
    },
    "Rounded" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستدير"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgerundet"
          }
        },
