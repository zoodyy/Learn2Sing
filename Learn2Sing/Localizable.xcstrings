    "Leap to the top note without reaching or pushing, then let the scale carry you back down." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقفز إلى النغمة العليا دون مدّ الصوت أو الضغط، ثم دع السلم يعيدك إلى الأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring zum obersten Ton, ohne dich zu strecken oder zu drücken, und lass dich dann von der Tonleiter wieder nach unten tragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta a la nota más alta sin estirarte ni empujar, y deja que la escala te lleve de vuelta abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sautez à la note du haut sans tendre ni pousser la voix, puis laissez la gamme vous ramener en bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta alla nota più alta senza allungarti né spingere, poi lascia che la scala ti riporti giù."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背伸びしたり押したりせずにいちばん上の音へ跳び、そこから音階に乗って下りてきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애써 뻗거나 밀어붙이지 말고 맨 위 음으로 도약한 뒤, 음계를 따라 다시 내려오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring naar de hoogste noot zonder te reiken of te duwen, en laat de toonladder je daarna weer naar beneden dragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skocz na najwyższy dźwięk bez sięgania i pchania, a potem pozwól, by gama sprowadziła cię w dół."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salte para a nota mais aguda sem se esticar nem empurrar e deixe a escala levar você de volta para baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прыгайте на верхнюю ноту, не тянясь и не давя, а затем позвольте гамме плавно вернуть вас вниз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa till den översta tonen utan att sträcka dig eller pressa, och låt sedan skalan bära dig ner igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzanmadan ve zorlamadan en üst notaya sıçrayın, sonra dizinin sizi aşağı geri taşımasına izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要够也不要挤，直接跳到最高音，然后顺着音阶回到下面。"
          }
        }
      }
    },
    "Leave Without Saving" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
