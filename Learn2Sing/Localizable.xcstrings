        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De naam die naast de oefeningen staat die je deelt. Twee gebruikers kunnen niet dezelfde hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
