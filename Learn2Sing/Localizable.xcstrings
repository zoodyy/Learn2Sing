    "Alternate the tip and the back of your tongue, like double tonguing on a flute. Keep the notes crisp and the air steady." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل بين طرف لسانك ومؤخرته، مثل اللسان المزدوج في العزف على الفلوت. أبقِ النغمات حادة والهواء ثابتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle zwischen Zungenspitze und Zungenrücken, wie beim Doppelzungenschlag auf der Flöte. Halte die Töne knackig und die Luft gleichmäßig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna la punta y la parte posterior de la lengua, como el doble picado en la flauta. Mantén las notas nítidas y el aire constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternez le bout et l’arrière de la langue, comme le double coup de langue à la flûte. Gardez des notes nettes et un souffle régulier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna la punta e la parte posteriore della lingua, come il doppio colpo di lingua sul flauto. Mantieni le note nitide e l’aria costante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルートのダブルタンギングのように、舌先と舌の奥を交互に使います。音は歯切れよく、息は一定に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플루트의 더블 텅잉처럼 혀끝과 혀 뒤쪽을 번갈아 쓰세요. 음은 또렷하게, 호흡은 일정하게 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissel af tussen de punt en de achterkant van je tong, zoals dubbeltongen op een fluit. Houd de noten scherp en de lucht gelijkmatig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprzemiennie używaj czubka i tyłu języka, jak przy podwójnym staccato na flecie. Dźwięki mają być wyraźne, a powietrze równe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne a ponta e a parte de trás da língua, como o golpe duplo de língua na flauta. Mantenha as notas nítidas e o ar constante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чередуйте кончик и корень языка, как при двойном стаккато на флейте. Ноты должны быть чёткими, а поток воздуха ровным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Växla mellan tungspetsen och bakre delen av tungan, som dubbelstöt på flöjt. Håll tonerna tydliga och luften jämn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flütteki çift dil tekniği gibi dilinizin ucunu ve arkasını sırayla kullanın. Notaları net, hava akışını sabit tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像长笛的双吐一样，交替使用舌尖和舌根。音要清脆，气息要稳定。"
          }
        }
      }
    },
