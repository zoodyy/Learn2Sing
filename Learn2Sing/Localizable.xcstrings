        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni esercizio che hai creato tu verrà eliminato, insieme al suo pattern MIDI e ai suoi punteggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
