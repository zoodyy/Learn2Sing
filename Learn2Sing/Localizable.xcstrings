    "Narrows the list to the exercises you have liked, or to the ones you have not. The button is filled in while a filter is on." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصر القائمة على التمارين التي أُعجبت بها، أو على التي لم تُعجب بها. يكون الزر ممتلئًا أثناء تفعيل عامل تصفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur die Übungen, die du magst, oder nur die anderen. Der Knopf ist ausgefüllt, solange ein Filter aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la lista a los ejercicios que te gustan, o a los que no. El botón se rellena mientras hay un filtro activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la liste aux exercices que vous aimez, ou à ceux que vous n’aimez pas. Le bouton est rempli tant qu’un filtre est actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe l’elenco agli esercizi a cui hai messo mi piace, o a quelli a cui non l’hai messo. Il pulsante è pieno finché un filtro è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「いいね」したエクササイズだけ、またはそれ以外だけに絞り込みます。フィルタが有効な間、ボタンは塗りつぶされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋아요를 누른 연습만, 또는 누르지 않은 연습만 보여줍니다. 필터가 켜져 있는 동안 버튼이 채워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt de lijst tot de oefeningen die je leuk vindt, of juist tot de andere. De knop is gevuld zolang er een filter aanstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawęża listę do ćwiczeń, które polubiłeś, albo do pozostałych. Przycisk jest wypełniony, dopóki filtr działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe a lista aos exercícios que você curtiu, ou aos que não curtiu. O botão fica preenchido enquanto há um filtro ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет в списке только упражнения, которые вам нравятся, или только остальные. Пока фильтр включён, кнопка залита."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsar listan till övningarna du gillat, eller till de andra. Knappen är ifylld så länge ett filter är på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listeyi beğendiğiniz egzersizlerle ya da beğenmediklerinizle sınırlar. Bir filtre açıkken düğme dolu görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只显示你点过赞的练习，或只显示未点赞的。筛选开启时按钮为实心。"
          }
        }
      }
    },
    "Narrows the list to where the exercises came from, to the ones you have shared, or to your favorites. The button is filled in while a filter is on." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصر القائمة على مصدر التمارين، أو على التي شاركتها، أو على المفضلة. يكون الزر ممتلئًا أثناء تفعيل عامل تصفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schränkt die Liste darauf ein, woher die Übungen stammen, auf die von dir geteilten oder auf deine Favoriten. Der Knopf ist ausgefüllt, solange ein Filter aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la lista según de dónde vienen los ejercicios, a los que has compartido o a tus favoritos. El botón se rellena mientras hay un filtro activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la liste selon la provenance des exercices, à ceux que vous avez partagés ou à vos favoris. Le bouton est rempli tant qu’un filtre est actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe l’elenco in base alla provenienza degli esercizi, a quelli che hai condiviso o ai tuoi preferiti. Il pulsante è pieno finché un filtro è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクササイズの入手元、自分が公開したもの、またはお気に入りだけに絞り込みます。フィルタが有効な間、ボタンは塗りつぶされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습의 출처별로, 내가 공유한 것만, 또는 즐겨찾기만 보이도록 좁힙니다. 필터가 켜져 있는 동안 버튼이 채워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt de lijst tot waar de oefeningen vandaan komen, tot die je hebt gedeeld of tot je favorieten. De knop is gevuld zolang er een filter aanstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawęża listę według tego, skąd pochodzą ćwiczenia, do tych, które udostępniłeś, albo do ulubionych. Przycisk jest wypełniony, dopóki filtr działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restringe a lista conforme a origem dos exercícios, aos que você compartilhou ou aos seus favoritos. O botão fica preenchido enquanto há um filtro ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сужает список по происхождению упражнений, до тех, которыми вы поделились, или до избранных. Пока фильтр включён, кнопка залита."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsar listan efter var övningarna kommer ifrån, till dem du delat eller till dina favoriter. Knappen är ifylld så länge ett filter är på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listeyi egzersizlerin nereden geldiğine, paylaştıklarınıza ya da favorilerinize göre daraltır. Bir filtre açıkken düğme dolu görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按练习的来源筛选，或只显示你分享过的或收藏的。筛选开启时按钮为实心。"
          }
        }
      }
    },
