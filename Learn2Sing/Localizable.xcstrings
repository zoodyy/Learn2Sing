            "value" : "Очищает список «Избранное» на вкладке «Главная». Упражнения в нём остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tömmer listan ”Favoriter” på fliken Hem. Övningarna i den behålls."
          }
        },
        "tr" : {
