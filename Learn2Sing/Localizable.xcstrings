    "Start on the top note in a light voice and carry that lightness down to the bottom and back up again." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ من النغمة العليا بصوت خفيف واحمل هذه الخفة إلى الأسفل ثم عُد إلى الأعلى مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne mit leichter Stimme auf dem obersten Ton und trage diese Leichtigkeit nach unten und wieder hinauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza en la nota más alta con voz ligera y lleva esa ligereza hasta abajo y de vuelta arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez sur la note du haut d’une voix légère et gardez cette légèreté jusqu’en bas, puis en remontant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia sulla nota più alta con voce leggera e porta quella leggerezza fino in fondo e di nuovo su."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん上の音から軽い声で始め、その軽さのまま下まで下り、また上がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 위 음에서 가벼운 목소리로 시작해 그 가벼움을 맨 아래까지, 그리고 다시 위로 가져가세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin op de hoogste noot met een lichte stem en neem die lichtheid mee naar beneden en weer omhoog."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij od najwyższego dźwięku lekkim głosem i zachowaj tę lekkość aż na dół i z powrotem w górę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece na nota mais aguda com voz leve e leve essa leveza até embaixo e de volta para cima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с верхней ноты лёгким голосом и сохраняйте эту лёгкость до самого низа и обратно вверх."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja på den översta tonen med lätt röst och bär lättheten ända ner och upp igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En üst notadan hafif bir sesle başlayın ve bu hafifliği en aşağıya ve yeniden yukarıya kadar taşıyın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用轻盈的声音从最高音开始，把这份轻盈一直带到最低处，再带回上面。"
          }
        }
      }
    },
    "Start Routine" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
