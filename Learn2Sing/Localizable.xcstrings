    "Pick the exercises to save, then send the file, copy it, or save it to Files." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Übungen aus, die gesichert werden sollen, und versende, kopiere oder sichere die Datei anschließend in „Dateien“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los ejercicios que quieres guardar y luego envía el archivo, cópialo o guárdalo en Archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les exercices à enregistrer, puis envoyez le fichier, copiez-le ou enregistrez-le dans Fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli gli esercizi da salvare, poi invia il file, copialo o salvalo in File."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存するエクササイズを選ぶと、ファイルを送信したり、コピーしたり、「ファイル」に保存したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장할 연습을 고른 다음 파일을 보내거나 복사하거나 ‘파일’ 앱에 저장하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de oefeningen die je wilt bewaren en verstuur, kopieer of bewaar het bestand daarna in Bestanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz ćwiczenia do zapisania, a potem wyślij plik, skopiuj go lub zapisz w Plikach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os exercícios a salvar e depois envie o arquivo, copie-o ou salve-o em Arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите упражнения для сохранения, а затем отправьте файл, скопируйте его или сохраните в «Файлы»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj övningarna som ska sparas och skicka sedan filen, kopiera den eller spara den i Filer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilecek egzersizleri seç, ardından dosyayı gönder, kopyala veya Dosyalar’a kaydet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先挑选要保存的练习，再发送、拷贝该文件或将其存储到“文件”。"
          }
        }
