    "Make a bratty \"Nay\" sound. You should feel some buzzing in your nose." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeuge ein freches „Nay“. Du solltest ein Kribbeln in der Nase spüren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz un «Nay» descarado. Deberías notar un cosquilleo en la nariz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produisez un « Nay » insolent. Vous devriez sentir un léger bourdonnement dans le nez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produci un “Nay” sfacciato. Dovresti sentire un ronzio nel naso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生意気な感じの「Nay」を出します。鼻にビリビリした響きを感じるはずです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짓궂은 느낌의 “Nay” 소리를 내세요. 코에서 약간의 진동이 느껴져야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een brutaal ‘Nay’-geluid. Je voelt daarbij wat gezoem in je neus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydaj bezczelne „Nay”. Powinieneś czuć brzęczenie w nosie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça um “Nay” atrevido. Você deve sentir uma vibração no nariz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Издайте дерзкое «Nay». Вы должны почувствовать лёгкое жужжание в носу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör ett näsvist ”Nay”-ljud. Du ska känna ett surrande i näsan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şımarık bir “Nay” sesi çıkarın. Burnunuzda bir titreşim hissetmelisiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发出略带调皮的“Nay”。你应该能感觉到鼻子里有些嗡嗡的振动。"
          }
        }
      }
    },
    "Make a nasty \"Ee\" sound. You should feel some resonance in your nose." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
