    "Clear the Home tab's favorites, routines and recently played list." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح المفضلة والروتينات وقائمة ما شُغّل مؤخرًا في تبويب الرئيسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leere die Favoriten, Routinen und die Liste der zuletzt gespielten Übungen im Start-Tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
