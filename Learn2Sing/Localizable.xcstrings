    "Keep singing until the ring fills." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singe weiter, bis der Ring gefüllt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue cantando hasta que el círculo se complete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez à chanter jusqu’à ce que l’anneau soit rempli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua a cantare finché l’anello non si riempie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リングが満ちるまで歌い続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링이 가득 찰 때까지 계속 부르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf zingen tot de ring vol is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śpiewaj, aż pierścień się wypełni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue cantando até o anel se completar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пойте, пока кольцо не заполнится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt sjunga tills ringen fylls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halka dolana kadar söylemeye devam edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续演唱，直到圆环填满。"
          }
        }
      }
    },
    "Keep your jaw and throat relaxed, lowering your larynx. You should feel some resonance in your lips." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte Kiefer und Kehle entspannt und senke den Kehlkopf. Du solltest etwas Resonanz in den Lippen spüren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén relajados la mandíbula y la garganta, bajando la laringe. Deberías notar algo de resonancia en los labios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la mâchoire et la gorge détendues, en abaissant le larynx. Vous devriez sentir une résonance dans les lèvres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni mascella e gola rilassate, abbassando la laringe. Dovresti sentire una certa risonanza sulle labbra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あごとのどをリラックスさせ、喉頭を下げます。唇に少し響きを感じるはずです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "턱과 목을 편안하게 유지하고 후두를 낮추세요. 입술에서 약간의 울림이 느껴져야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je kaak en keel ontspannen en laat je strottenhoofd zakken. Je hoort en voelt wat resonantie in je lippen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj szczękę i gardło rozluźnione, obniżając krtań. Powinieneś czuć rezonans w wargach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o maxilar e a garganta relaxados, abaixando a laringe. Você deve sentir alguma ressonância nos lábios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите челюсть и горло расслабленными, опуская гортань. Вы должны почувствовать резонанс в губах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll käken och halsen avslappnade och sänk struphuvudet. Du ska känna viss resonans i läpparna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çenenizi ve boğazınızı gevşek tutun, gırtlağınızı aşağıda tutun. Dudaklarınızda bir miktar rezonans hissetmelisiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持下颌和喉咙放松，并降低喉头。你应该能感觉到嘴唇有一些共鸣。"
          }
        }
      }
    },
    "Keeps the app in the chosen orientation. “Don't lock” lets it rotate with your device." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die App in der gewählten Ausrichtung. „Nicht sperren“ lässt sie mit dem Gerät mitdrehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la app en la orientación elegida. «No bloquear» deja que gire con el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient l’app dans l’orientation choisie. « Ne pas verrouiller » la laisse pivoter avec l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene l’app nell’orientamento scelto. “Non bloccare” le permette di ruotare con il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを選んだ向きに固定します。「ロックしない」を選ぶと端末に合わせて回転します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 선택한 방향으로 유지합니다. “잠그지 않음”을 선택하면 기기에 따라 회전합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt de app in de gekozen oriëntatie. ‘Niet vergrendelen’ laat de app met je apparaat meedraaien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuje aplikację w wybranej orientacji. „Nie blokuj” pozwala jej obracać się razem z urządzeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o app na orientação escolhida. “Não bloquear” deixa girar junto com o dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживает приложение в выбранной ориентации. «Не блокировать» позволяет поворачиваться вместе с устройством."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håller appen i det valda läget. ”Lås inte” låter den rotera med enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı seçilen yönlendirmede tutar. “Kilitleme”, cihazla birlikte dönmesine izin verir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让应用保持所选方向。“不锁定”则随设备一起旋转。"
          }
        }
      }
    },
