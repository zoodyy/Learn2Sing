    "Shows which repetition you're on out of the total, e.g. “2/5”. Hidden for exercises that don't repeat." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt, bei welcher Wiederholung von wie vielen du bist, z. B. „2/5“. Bei Übungen ohne Wiederholung ausgeblendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra en qué repetición vas del total, p. ej. «2/5». Se oculta en los ejercicios que no se repiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique la répétition en cours sur le total, p. ex. « 2/5 ». Masqué pour les exercices sans répétition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a quale ripetizione sei sul totale, ad es. “2/5”. Nascosto per gli esercizi che non si ripetono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全体のうち何回目の繰り返しかを表示します（例:「2/5」）。繰り返さないエクササイズでは非表示です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 중 몇 번째 반복인지 표시합니다(예: “2/5”). 반복하지 않는 연습에서는 숨겨집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont bij welke herhaling je bent van het totaal, bijv. ‘2/5’. Verborgen bij oefeningen zonder herhaling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje, przy którym powtórzeniu jesteś z łącznej liczby, np. „2/5”. Ukryty przy ćwiczeniach bez powtórzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra em qual repetição você está do total, por ex. “2/5”. Fica oculto em exercícios que não repetem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает, какой сейчас повтор из общего числа, например «2/5». Скрыт для упражнений без повторов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar vilken repetition du är på av totalt, t.ex. ”2/5”. Dolt för övningar som inte repeteras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplam içinde kaçıncı tekrarda olduğunuzu gösterir, ör. “2/5”. Tekrarlanmayan egzersizlerde gizlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示当前是第几次重复（例如“2/5”）。对不重复的练习会隐藏。"
          }
        }
      }
    },
