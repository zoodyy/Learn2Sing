        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 레슨이 다시 미완료로 표시되고, 홈 탭의 “읽기 레슨”은 첫 레슨부터 추천합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
