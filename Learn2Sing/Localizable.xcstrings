        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta gli esercizi qui sopra uno dopo l’altro, partendo dall’alto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上のエクササイズを、先頭から順に続けて歌います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 연습들을 맨 위부터 차례로 부릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zingt de oefeningen hierboven na elkaar, van boven af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śpiewa ćwiczenia powyżej jedno po drugim, od góry."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta os exercícios acima um após o outro, a partir do topo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поёт упражнения выше одно за другим, начиная сверху."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjunger övningarna ovan efter varandra, uppifrån."
