    "Now sing the highest note you can and hold it steadily for 2 seconds." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singe nun den höchsten Ton, den du kannst, und halte ihn 2 Sekunden lang gleichmäßig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora canta la nota más aguda que puedas y mantenla de forma estable durante 2 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chantez maintenant la note la plus aiguë possible et tenez-la de façon stable pendant 2 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora canta la nota più alta che riesci e tienila ferma per 2 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に、出せる限り高い音を歌い、2秒間まっすぐ伸ばしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 낼 수 있는 가장 높은 음을 2초 동안 안정적으로 유지하며 부르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zing nu de hoogste noot die je kunt en houd die 2 seconden stabiel aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz zaśpiewaj najwyższy dźwięk, jaki potrafisz, i utrzymaj go równo przez 2 sekundy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora cante a nota mais aguda que conseguir e sustente-a por 2 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь спойте самую высокую ноту, которую можете, и держите её ровно 2 секунды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjung nu din högsta möjliga ton och håll den stadigt i 2 sekunder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi çıkarabildiğiniz en tiz notayı söyleyin ve 2 saniye boyunca sabit tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在唱出你能发出的最高音，并稳定保持 2 秒。"
          }
        }
      }
    },
