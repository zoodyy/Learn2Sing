    },
    "You haven't changed any of the exercises that came with the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تغيّر أيًا من التمارين المرفقة مع التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
