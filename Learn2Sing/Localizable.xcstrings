        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualche parola su di te, mostrata in cima al tuo profilo nella scheda Comunità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分についての短い紹介です。コミュニティタブのプロフィール上部に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자신에 대한 짧은 소개입니다. 커뮤니티 탭 프로필 맨 위에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een paar woorden over jezelf, bovenaan je profiel op het Community-tabblad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilka słów o tobie, pokazywanych na górze twojego profilu na karcie Społeczność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas palavras sobre você, mostradas no topo do seu perfil na aba Comunidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несколько слов о себе. Они видны вверху вашего профиля на вкладке «Сообщество»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Några ord om dig själv, som visas överst på din profil i Community-fliken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendinizle ilgili birkaç söz; Topluluk sekmesindeki profilinizin en üstünde görünür."
          }
