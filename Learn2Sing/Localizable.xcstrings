    "Empties the Home tab's “Favourites” list. The exercises in it are kept." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leert die Liste „Favoriten“ im Start-Tab. Die darin enthaltenen Übungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía la lista «Favoritos» de la pestaña Inicio. Los ejercicios que contiene se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vide la liste « Favoris » de l’onglet Accueil. Les exercices qu’elle contient sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
