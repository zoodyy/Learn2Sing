    "Choose the sound that plays the notes, or upload your own." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den Klang, mit dem die Noten gespielt werden, oder lade einen eigenen hoch."
          }
        },
        "es" : {
