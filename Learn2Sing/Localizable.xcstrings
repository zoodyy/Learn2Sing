    "Maintain a steady airflow and consistent mouth placement." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen gleichmäßigen Luftstrom und eine gleichbleibende Mundstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén un flujo de aire constante y una posición de la boca estable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez un flux d’air régulier et une position de bouche constante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni un flusso d’aria costante e una posizione della bocca uniforme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息の流れを一定に保ち、口の形も変えないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일정한 호흡 흐름과 변함없는 입 모양을 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een gelijkmatige luchtstroom en een constante mondstand aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj równy przepływ powietrza i stałe ułożenie ust."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha um fluxo de ar constante e a posição da boca estável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживайте ровный поток воздуха и неизменное положение рта."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ett jämnt luftflöde och en konsekvent munställning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenli bir hava akışı ve tutarlı bir ağız konumu koruyun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持稳定的气流和一致的口型位置。"
          }
        }
      }
    },
