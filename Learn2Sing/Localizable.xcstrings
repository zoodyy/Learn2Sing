    "Keep every note of the arpeggio clear and connected. Aim for the center of each note instead of sliding." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ كل نغمة في الأربيجيو واضحة ومتصلة. استهدف مركز كل نغمة بدلًا من الانزلاق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte jeden Ton des Arpeggios klar und verbunden. Triff die Mitte jedes Tons, statt zu rutschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén cada nota del arpegio clara y unida. Apunta al centro de cada nota en lugar de deslizarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez chaque note de l’arpège claire et liée. Visez le centre de chaque note au lieu de glisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni ogni nota dell’arpeggio chiara e legata. Punta al centro di ogni nota invece di scivolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルペジオのどの音も、はっきりとつなげて歌います。ずり上げずに各音の中心をねらいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아르페지오의 모든 음을 또렷하고 이어지게 부르세요. 미끄러지지 말고 각 음의 중심을 겨냥하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd elke noot van het arpeggio helder en verbonden. Mik op het midden van elke noot in plaats van te glijden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy dźwięk arpeggia ma być wyraźny i połączony. Celuj w środek każdego dźwięku, zamiast się ślizgać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha cada nota do arpejo clara e ligada. Mire no centro de cada nota em vez de deslizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая нота арпеджио должна быть чёткой и связанной с соседними. Попадайте в центр ноты, а не подъезжайте к ней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll varje ton i arpeggiot tydlig och sammanbunden. Sikta på mitten av varje ton i stället för att glida."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arpejin her notasını net ve bağlı tutun. Kaymak yerine her notanın tam ortasını hedefleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "琶音中的每个音都要清晰而连贯。瞄准每个音的中心，不要滑音。"
          }
        }
      }
    },
    "Keep every step even and your tone the same from the bottom note to the top." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على تساوي كل خطوة وعلى نبرتك نفسها من النغمة السفلى إلى العليا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte jeden Schritt gleichmäßig und deinen Klang vom tiefsten bis zum höchsten Ton gleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén cada paso uniforme y el mismo tono desde la nota más grave hasta la más aguda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez chaque pas régulier et le même timbre de la note la plus basse à la plus haute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni ogni passo uniforme e lo stesso suono dalla nota più bassa alla più alta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一歩一歩を均等にし、いちばん下の音から上の音まで同じ音色を保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 음정 간격을 고르게 하고 맨 아래 음부터 맨 위 음까지 같은 음색을 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd elke stap gelijk en je klank hetzelfde van de laagste tot de hoogste noot."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj każdy krok równy, a barwę taką samą od najniższego do najwyższego dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha cada passo uniforme e o mesmo timbre da nota mais grave à mais aguda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делайте каждый шаг ровным и сохраняйте одинаковый тембр от нижней ноты до верхней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll varje steg jämnt och klangen densamma från den lägsta tonen till den högsta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her adımı eşit tutun ve en pes notadan en tize kadar aynı tonu koruyun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一步都保持均匀，从最低音到最高音保持同样的音色。"
          }
        }
      }
    },
    "Keep singing until the ring fills." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واصل الغناء حتى تمتلئ الحلقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singe weiter, bis der Ring gefüllt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue cantando hasta que el círculo se complete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez à chanter jusqu’à ce que l’anneau soit rempli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua a cantare finché l’anello non si riempie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リングが満ちるまで歌い続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링이 가득 찰 때까지 계속 부르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf zingen tot de ring vol is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śpiewaj, aż pierścień się wypełni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue cantando até o anel se completar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пойте, пока кольцо не заполнится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt sjunga tills ringen fylls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halka dolana kadar söylemeye devam edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续演唱，直到圆环填满。"
          }
        }
      }
    },
    "Keep the \"Ee\" narrow and bright on the leap and don't let your jaw drop to reach the top." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ «Ee» ضيقة ومشرقة في القفزة ولا تدع فكك ينخفض للوصول إلى الأعلى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das „Ee“ beim Sprung schmal und hell und lass den Kiefer nicht fallen, um nach oben zu kommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la «Ee» estrecha y brillante en el salto y no dejes caer la mandíbula para alcanzar la nota alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le « Ee » étroit et brillant sur le saut et ne laissez pas la mâchoire tomber pour atteindre le haut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la “Ee” stretta e brillante nel salto e non abbassare la mascella per raggiungere la nota alta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳躍では「Ee」を細く明るく保ち、高い音を取ろうとしてあごを下げないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도약할 때 “Ee”를 좁고 밝게 유지하고, 높은 음에 닿으려고 턱을 떨어뜨리지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de ‘Ee’ smal en helder op de sprong en laat je kaak niet zakken om de top te halen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj „Ee” wąskie i jasne w skoku i nie opuszczaj szczęki, żeby sięgnąć góry."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o “Ee” estreito e brilhante no salto e não deixe o maxilar cair para alcançar o topo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На скачке держите «Ee» узким и ярким и не опускайте челюсть, чтобы дотянуться до верха."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ”Ee” smalt och ljust i hoppet och låt inte käken sjunka för att nå toppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıçramada “Ee” sesini dar ve parlak tutun, tepeye ulaşmak için çenenizi düşürmeyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳进时让“Ee”保持窄而明亮，不要为了够到高音而让下颌掉下来。"
          }
        }
      }
    },
    "Keep the \"M\" buzzing in your lips and change only the vowel. Your jaw should stay loose and still." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ طنين «M» في شفتيك وغيّر حرف العلة فقط. يجب أن يبقى فكك مرتخيًا وثابتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass das „M“ in den Lippen summen und wechsle nur den Vokal. Dein Kiefer bleibt locker und ruhig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la «M» vibrando en los labios y cambia solo la vocal. La mandíbula debe quedarse suelta y quieta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le « M » qui vibre dans les lèvres et ne changez que la voyelle. La mâchoire reste détendue et immobile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la “M” che vibra sulle labbra e cambia solo la vocale. La mascella deve restare sciolta e ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「M」の響きを唇に保ったまま、母音だけを変えます。あごはゆるめて動かさないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“M”의 울림을 입술에 유지한 채 모음만 바꾸세요. 턱은 느슨하게, 움직이지 않게 두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de ‘M’ in je lippen zoemen en verander alleen de klinker. Je kaak blijft los en stil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niech „M” brzęczy w wargach, a zmieniaj tylko samogłoskę. Szczęka ma pozostać luźna i nieruchoma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o “M” vibrando nos lábios e mude apenas a vogal. O maxilar deve ficar solto e parado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пусть «M» вибрирует в губах, а меняется только гласная. Челюсть остаётся расслабленной и неподвижной."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt ”M” surra i läpparna och byt bara vokal. Käken ska vara lös och stilla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“M” sesinin dudaklarınızda titreşmesini sağlayın ve yalnızca ünlüyü değiştirin. Çeneniz gevşek ve hareketsiz kalmalı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让“M”在嘴唇上保持振动，只改变元音。下颌保持放松、不动。"
          }
        }
      }
    },
    "Keep the \"Nah\" bright and forward all the way up, so the top note doesn't feel like a reach." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ «Nah» مشرقة ومتقدمة طوال الصعود، حتى لا تبدو النغمة العليا بعيدة المنال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das „Nah“ bis ganz nach oben hell und vorne, damit sich der oberste Ton nicht wie ein Strecken anfühlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la «Nah» brillante y adelante durante toda la subida, para que la nota más alta no se sienta como un esfuerzo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le « Nah » brillant et vers l’avant jusqu’en haut, pour que la note du haut ne demande pas d’effort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la “Nah” brillante e in avanti fino in cima, così la nota più alta non sembra uno sforzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん上まで「Nah」を明るく前に保てば、最高音も背伸びせずに出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 위까지 “Nah”를 밝고 앞쪽에 유지해서 가장 높은 음이 무리하게 느껴지지 않게 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de ‘Nah’ helder en voorin tot helemaal boven, zodat de hoogste noot niet als reiken voelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj „Nah” jasne i z przodu aż do góry, aby najwyższy dźwięk nie wymagał sięgania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o “Nah” brilhante e à frente até o topo, para que a nota mais aguda não pareça um esforço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите «Nah» ярким и направленным вперёд до самого верха, чтобы верхняя нота не требовала усилия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ”Nah” ljust och framåt hela vägen upp, så att den översta tonen inte känns som en sträckning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En üst notaya uzanıyormuş gibi hissetmemek için “Nah” sesini tepeye kadar parlak ve önde tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一直到最高处都让“Nah”保持明亮、靠前，这样最高音就不会显得吃力。"
          }
        }
      }
    },
    "Keep the back of your tongue loose on each \"G\" and let your jaw drop on the \"Ah\". The \"G\" helps your vocal folds close cleanly." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ مؤخرة لسانك مرتخية مع كل «G» ودع فكك ينخفض على «Ah». يساعد «G» حبالك الصوتية على الانغلاق بشكل نظيف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den hinteren Teil der Zunge bei jedem „G“ locker und lass den Kiefer beim „Ah“ fallen. Das „G“ hilft deinen Stimmlippen, sauber zu schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén suelta la parte posterior de la lengua en cada «G» y deja caer la mandíbula en la «Ah». La «G» ayuda a que las cuerdas vocales se cierren limpiamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez l’arrière de la langue souple sur chaque « G » et laissez tomber la mâchoire sur le « Ah ». Le « G » aide vos cordes vocales à se fermer nettement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni sciolta la parte posteriore della lingua su ogni “G” e lascia cadere la mascella sulla “Ah”. La “G” aiuta le corde vocali a chiudersi in modo pulito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの「G」でも舌の奥をゆるめ、「Ah」ではあごを下ろします。「G」は声帯をきれいに閉じる助けになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“G”마다 혀 뒤쪽을 느슨하게 하고 “Ah”에서 턱을 떨어뜨리세요. “G”는 성대가 깔끔하게 닫히도록 도와줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het achterste deel van je tong los bij elke ‘G’ en laat je kaak zakken op de ‘Ah’. De ‘G’ helpt je stembanden netjes te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj tył języka luźny przy każdym „G” i opuszczaj szczękę na „Ah”. „G” pomaga fałdom głosowym czysto się zamykać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a parte de trás da língua solta em cada “G” e deixe o maxilar cair no “Ah”. O “G” ajuda as pregas vocais a se fecharem de forma limpa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите заднюю часть языка свободной на каждом «G» и опускайте челюсть на «Ah». «G» помогает голосовым складкам чисто смыкаться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll bakre delen av tungan lös på varje ”G” och låt käken sjunka på ”Ah”. ”G” hjälper stämläpparna att sluta rent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her “G” sesinde dilinizin arka kısmını gevşek tutun ve “Ah” sesinde çenenizi bırakın. “G” sesi ses tellerinizin temiz kapanmasına yardımcı olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个“G”都保持舌根放松，在“Ah”上让下颌自然落下。“G”能帮助声带干净地闭合。"
          }
        }
      }
    },
    "Keep the sound forward in your face as the vowel opens from \"Nee\" to \"Nah\". Don't let the \"Nah\" fall back into your throat." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ الصوت في مقدمة وجهك بينما ينفتح حرف العلة من «Nee» إلى «Nah». لا تدع «Nah» تتراجع إلى حلقك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Klang vorne im Gesicht, während sich der Vokal von „Nee“ zu „Nah“ öffnet. Lass das „Nah“ nicht in den Hals zurückfallen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el sonido adelante en la cara mientras la vocal se abre de «Nee» a «Nah». No dejes que la «Nah» caiga hacia la garganta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le son vers l’avant du visage pendant que la voyelle s’ouvre de « Nee » à « Nah ». Ne laissez pas le « Nah » retomber dans la gorge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni il suono in avanti sul viso mentre la vocale si apre da “Nee” a “Nah”. Non lasciare che la “Nah” ricada in gola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "母音が「Nee」から「Nah」へ開いても、響きを顔の前方に保ちます。「Nah」がのどの奥に落ちないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모음이 “Nee”에서 “Nah”로 열리는 동안 소리를 얼굴 앞쪽에 유지하세요. “Nah”가 목 안으로 떨어지지 않게 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de klank voor in je gezicht terwijl de klinker opengaat van ‘Nee’ naar ‘Nah’. Laat de ‘Nah’ niet terugvallen in je keel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj dźwięk z przodu twarzy, gdy samogłoska otwiera się z „Nee” na „Nah”. Nie pozwól, by „Nah” cofnęło się do gardła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o som à frente, no rosto, enquanto a vogal se abre de “Nee” para “Nah”. Não deixe o “Nah” cair para a garganta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите звук впереди, в маске лица, пока гласная раскрывается от «Nee» к «Nah». Не давайте «Nah» провалиться в горло."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll klangen framme i ansiktet medan vokalen öppnas från ”Nee” till ”Nah”. Låt inte ”Nah” falla tillbaka ner i halsen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ünlü “Nee”den “Nah”a açılırken sesi yüzünüzün önünde tutun. “Nah” sesinin boğazınıza geri düşmesine izin vermeyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元音从“Nee”打开到“Nah”时，让声音保持在面部前方。不要让“Nah”落回喉咙里。"
          }
        }
      }
    },
    "Keep your breath flowing through the top of the arpeggio and don't grab the high note." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ نفَسك متدفقًا عبر قمة الأربيجيو ولا تنتزع النغمة العالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass den Atem über den Gipfel des Arpeggios weiterfließen und pack den hohen Ton nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el aire fluyendo en la parte alta del arpegio y no agarres la nota aguda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le souffle circuler au sommet de l’arpège et ne saisissez pas la note aiguë."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia fluire il respiro sulla cima dell’arpeggio e non afferrare la nota acuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルペジオの頂点でも息を流し続け、高い音をつかみにいかないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아르페지오의 꼭대기에서도 호흡이 계속 흐르게 하고, 높은 음을 움켜잡지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je adem doorstromen over de top van het arpeggio en grijp de hoge noot niet vast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niech oddech płynie przez szczyt arpeggia i nie chwytaj na siłę wysokiego dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o ar fluindo no topo do arpejo e não agarre a nota aguda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пусть дыхание свободно проходит через вершину арпеджио, не зажимайте верхнюю ноту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt andningen flöda genom arpeggiots topp och grip inte tag i den höga tonen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nefesinizin arpejin tepesinden akmaya devam etmesine izin verin ve tiz notayı sıkmayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在琶音的最高处保持气息流动，不要去抓高音。"
          }
        }
      }
    },
    "Keep your knees soft instead of locking them. Locked knees can create tension in your pelvis, and choir singers are often warned that standing still with locked knees for a long time can make them faint." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ ركبتيك لينتين بدل أن تُقفلهما مشدودتين. فالركبتان المقفلتان قد تسببان توترًا في الحوض، وكثيرًا ما يُحذَّر مغنو الجوقة من أن الوقوف طويلًا دون حركة بركبتين مقفلتين قد يُفقدهم الوعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte deine Knie locker, statt sie durchzudrücken. Durchgedrückte Knie können Spannung im Becken erzeugen, und Chorsänger werden oft gewarnt, dass langes Stillstehen mit durchgedrückten Knien sie ohnmächtig werden lassen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén las rodillas flexibles en lugar de bloquearlas. Las rodillas bloqueadas pueden crear tensión en la pelvis, y a los cantantes de coro se les suele advertir que estar mucho tiempo quietos con las rodillas bloqueadas puede hacerles desmayarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez les genoux souples au lieu de les verrouiller. Des genoux verrouillés peuvent créer des tensions dans le bassin, et on prévient souvent les choristes que rester longtemps immobile les genoux verrouillés peut les faire s’évanouir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni le ginocchia morbide invece di bloccarle. Le ginocchia bloccate possono creare tensione nel bacino, e ai coristi si raccomanda spesso di non restare a lungo fermi con le ginocchia bloccate, perché si rischia di svenire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひざはピンと伸ばしきらず、やわらかく保ちましょう。ひざを固めると骨盤まわりに力みが生まれることがあります。また合唱では、ひざを伸ばしきったまま長く立ち続けると気を失うことがあると、よく注意されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무릎을 잠그지 말고 부드럽게 유지하세요. 무릎을 쭉 펴서 고정하면 골반에 긴장이 생길 수 있고, 합창단원들은 무릎을 고정한 채 오래 가만히 서 있으면 기절할 수 있다는 주의를 자주 듣습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je knieën licht gebogen in plaats van ze op slot te zetten. Knieën op slot kunnen spanning in je bekken geven, en koorzangers wordt vaak gewaarschuwd dat lang stilstaan met knieën op slot ze kan laten flauwvallen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj kolana miękkie zamiast je blokować. Zablokowane kolana mogą powodować napięcie w miednicy, a chórzystów często ostrzega się, że długie stanie bez ruchu z zablokowanymi kolanami może doprowadzić do omdlenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os joelhos soltos em vez de travá-los. Joelhos travados podem criar tensão na pélvis, e cantores de coro costumam ser alertados de que ficar parado por muito tempo com os joelhos travados pode fazê-los desmaiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите колени мягкими, а не зажатыми. Зажатые колени могут создавать напряжение в тазу, а хористов часто предупреждают, что если долго стоять неподвижно с зажатыми коленями, можно упасть в обморок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll knäna mjuka i stället för att låsa dem. Låsta knän kan skapa spänningar i bäckenet, och körsångare varnas ofta för att de kan svimma om de står stilla länge med låsta knän."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizlerinizi kilitlemek yerine hafifçe gevşek tutun. Kilitli dizler leğen kemiğinizde gerginlik yaratabilir; koro şarkıcıları da uzun süre kilitli dizlerle hareketsiz durmanın bayılmaya yol açabileceği konusunda sık sık uyarılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "膝盖要保持放松微屈，不要绷直锁死。锁住膝盖会让骨盆紧张，合唱歌手也常被提醒：长时间锁着膝盖一动不动地站着，可能会晕倒。"
          }
        }
      }
    },
    "Keep your lips springy and your throat relaxed. Let the air carry you through the consonants without stopping." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ شفتيك مرنتين وحلقك مسترخيًا. دع الهواء يحملك عبر الحروف الساكنة دون توقف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Lippen federnd und den Hals entspannt. Lass dich von der Luft ohne Unterbrechung durch die Konsonanten tragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén los labios elásticos y la garganta relajada. Deja que el aire te lleve a través de las consonantes sin detenerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez les lèvres souples et la gorge détendue. Laissez l’air vous porter à travers les consonnes sans vous arrêter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni le labbra elastiche e la gola rilassata. Lascia che l’aria ti porti attraverso le consonanti senza fermarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唇は弾むように、のどはリラックスさせます。息の流れに乗って、止まらずに子音を通り抜けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입술은 탄력 있게, 목은 편안하게 유지하세요. 멈추지 말고 호흡이 자음을 지나 이어지게 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je lippen veerkrachtig en je keel ontspannen. Laat de lucht je zonder te stoppen door de medeklinkers dragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj sprężyste wargi i rozluźnione gardło. Pozwól, by powietrze niosło cię przez spółgłoski bez zatrzymywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os lábios elásticos e a garganta relaxada. Deixe o ar levar você pelas consoantes sem parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Губы должны быть упругими, а горло расслабленным. Пусть воздух несёт вас через согласные без остановок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll läpparna spänstiga och halsen avslappnad. Låt luften bära dig genom konsonanterna utan att stanna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dudaklarınızı esnek, boğazınızı gevşek tutun. Havanın sizi durmadan ünsüzlerin içinden taşımasına izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘴唇保持弹性，喉咙保持放松。让气流带着你连续地通过辅音，不要停顿。"
          }
        }
      }
    },
    "Keep your mouth shape the same all the way up and let the top note be lighter, not louder." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على شكل فمك نفسه طوال الصعود ودع النغمة العليا تكون أخف، لا أعلى صوتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte die Mundform bis ganz nach oben bei und lass den obersten Ton leichter werden, nicht lauter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la misma forma de la boca durante toda la subida y deja que la nota más alta sea más ligera, no más fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la même forme de bouche jusqu’en haut et laissez la note du haut devenir plus légère, pas plus forte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la stessa forma della bocca fino in cima e lascia che la nota più alta sia più leggera, non più forte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん上まで口の形を変えず、最高音は大きくではなく軽く出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 위까지 입 모양을 똑같이 유지하고, 가장 높은 음은 크게가 아니라 가볍게 내세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je mondvorm hetzelfde tot helemaal boven en laat de hoogste noot lichter worden, niet harder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj ten sam kształt ust aż do góry, a najwyższy dźwięk niech będzie lżejszy, nie głośniejszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o mesmo formato da boca até o topo e deixe a nota mais aguda mais leve, não mais forte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте одну и ту же форму рта до самого верха, и пусть верхняя нота будет легче, а не громче."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåll samma munform hela vägen upp och låt den översta tonen bli lättare, inte starkare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağız şeklinizi en tepeye kadar aynı tutun ve en üst notanın daha yüksek değil, daha hafif olmasına izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一直到最高处都保持同样的口型，让最高音更轻，而不是更响。"
          }
        }
      }
    },
    "Keep your tongue light and quick and make the two vowels clearly different." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ لسانك خفيفًا وسريعًا واجعل حرفي العلة مختلفين بوضوح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Zunge leicht und schnell und lass die beiden Vokale deutlich unterschiedlich klingen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la lengua ligera y rápida y haz que las dos vocales suenen claramente distintas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la langue légère et rapide, et faites bien entendre la différence entre les deux voyelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni la lingua leggera e rapida e rendi le due vocali ben distinte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舌を軽く素早く動かし、2つの母音をはっきり区別します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혀를 가볍고 빠르게 움직이고 두 모음을 분명하게 구분하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je tong licht en snel en maak de twee klinkers duidelijk verschillend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj język lekki i szybki, a obie samogłoski wyraźnie od siebie odróżniaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a língua leve e rápida e deixe as duas vogais claramente diferentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык должен быть лёгким и быстрым, а две гласные должны явно различаться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll tungan lätt och snabb och gör de två vokalerna tydligt olika."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilinizi hafif ve çevik tutun, iki ünlüyü de birbirinden belirgin şekilde ayırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舌头保持轻快，两个元音要清楚地区分开。"
          }
        }
      }
    },
    "Keeps the app in the chosen orientation. “Don't lock” lets it rotate with your device." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي التطبيق في الاتجاه المختار. «بدون قفل» يتيح له الدوران مع جهازك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die App in der gewählten Ausrichtung. „Nicht sperren“ lässt sie mit dem Gerät mitdrehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la app en la orientación elegida. «No bloquear» deja que gire con el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient l’app dans l’orientation choisie. « Ne pas verrouiller » la laisse pivoter avec l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene l’app nell’orientamento scelto. “Non bloccare” le permette di ruotare con il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを選んだ向きに固定します。「ロックしない」を選ぶと端末に合わせて回転します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 선택한 방향으로 유지합니다. “잠그지 않음”을 선택하면 기기에 따라 회전합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt de app in de gekozen oriëntatie. ‘Niet vergrendelen’ laat de app met je apparaat meedraaien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuje aplikację w wybranej orientacji. „Nie blokuj” pozwala jej obracać się razem z urządzeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o app na orientação escolhida. “Não bloquear” deixa girar junto com o dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживает приложение в выбранной ориентации. «Не блокировать» позволяет поворачиваться вместе с устройством."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håller appen i det valda läget. ”Lås inte” låter den rotera med enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı seçilen yönlendirmede tutar. “Kilitleme”, cihazla birlikte dönmesine izin verir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让应用保持所选方向。“不锁定”则随设备一起旋转。"
          }
        }
      }
    },
    "Keeps this range as your own, under “Custom” in the Voice settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ بهذا المدى كمداك الخاص، ضمن «مخصص» في إعدادات «الصوت»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält diesen Umfang als deinen eigenen, unter „Eigene“ in den Stimm-Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda este rango como el tuyo, en «Personalizado» dentro de los ajustes de Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve cette tessiture comme la vôtre, sous « Personnalisé » dans les réglages Voix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva questa estensione come la tua, sotto “Personalizzato” nelle impostazioni Voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この音域をあなた自身の音域として、声の設定の「カスタム」に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 음역을 당신의 것으로 저장합니다. 음성 설정의 “사용자 지정”에 들어갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart dit bereik als het jouwe, onder ‘Aangepast’ in de Stem-instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuje tę skalę jako twoją własną, w pozycji „Własne” w ustawieniach Głosu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda esta extensão como a sua, em “Personalizado” nos ajustes de Voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет этот диапазон как ваш собственный, в разделе «Свои» настроек голоса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller det här omfånget som ditt eget, under ”Egna” i Röst-inställningarna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aralığı kendi aralığınız olarak, Ses ayarlarındaki “Özel” seçeneği altında saklar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把这个音域保存为你自己的，位于“嗓音”设置里的“自定义”下。"
          }
        }
      }
    },
