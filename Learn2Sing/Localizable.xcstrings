        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke herhaling begint dit aantal halve tonen boven de vorige. Een negatieve waarde gaat omlaag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde powtórzenie zaczyna się o tyle półtonów wyżej niż poprzednie. Wartość ujemna prowadzi w dół."
