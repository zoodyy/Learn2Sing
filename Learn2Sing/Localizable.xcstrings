    },
    "Erase notes and labels by dragging across them." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح النغمات والتسميات بالسحب فوقها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Noten und Beschriftungen, indem du über sie hinwegziehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra notas y etiquetas arrastrando por encima de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface les notes et les libellés en faisant glisser le doigt dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella note ed etichette trascinando sopra di esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音符やラベルの上をドラッグして消します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음과 라벨 위를 드래그해 지웁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wist noten en labels door er met je vinger overheen te slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymazuje nuty i etykiety: przeciągnij po nich palcem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga notas e rótulos arrastando por cima deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
