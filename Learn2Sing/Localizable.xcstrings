{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" and its audio file will be deleted. This cannot be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und die zugehörige Audiodatei werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán «%@» y su archivo de audio. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et son fichier audio seront supprimés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e il suo file audio verranno eliminati. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」とそのオーディオファイルが削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”과(와) 해당 오디오 파일이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ en het bijbehorende audiobestand worden verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” i jego plik dźwiękowy zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e seu arquivo de áudio serão excluídos. Isso não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» и его аудиофайл будут удалены. Это действие нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” och dess ljudfil raderas. Det går inte att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ve ses dosyası silinecek. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除“%@”及其音频文件。此操作无法撤销。"
          }
        }
      }
    },
    "\"%@\" and its MIDI pattern will be deleted. This cannot be undone." : {
