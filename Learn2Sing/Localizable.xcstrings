    "Pauses the exercise. Tap again to carry on from where you stopped." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die Übung an. Tippe noch einmal, um dort weiterzumachen, wo du aufgehört hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa el ejercicio. Toca otra vez para seguir donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met l’exercice en pause. Touchez à nouveau pour reprendre là où vous vous êtes arrêté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa l’esercizio. Tocca di nuovo per riprendere da dove ti eri fermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクササイズを一時停止します。もう一度タップすると、止めたところから続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습을 일시정지합니다. 다시 탭하면 멈춘 곳부터 이어집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzeert de oefening. Tik opnieuw om verder te gaan waar je gebleven was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuje ćwiczenie. Dotknij ponownie, aby ruszyć dalej od miejsca zatrzymania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa o exercício. Toque de novo para continuar de onde parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставит упражнение на паузу. Нажмите ещё раз, чтобы продолжить с того же места."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar övningen. Tryck igen för att fortsätta där du slutade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egzersizi duraklatır. Kaldığınız yerden devam etmek için tekrar dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停练习。再次点按可从停下的地方继续。"
          }
        }
      }
    },
