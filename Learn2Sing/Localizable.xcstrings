          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Представляйте гамму, скрытую под скачками, чтобы каждая нота звучала чисто."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänk på skalan under hoppen, så att varje ton landar rent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her notanın doğru perdeye oturması için atlamaların altındaki diziyi düşünün."
