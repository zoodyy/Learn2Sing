    "Optional, and only needed if you'd like an answer. Left blank, your message is still read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional und nur nötig, wenn du eine Antwort möchtest. Ohne Adresse wird deine Nachricht trotzdem gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional, solo hace falta si quieres respuesta. Si lo dejas en blanco, tu mensaje se lee igualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif, utile seulement si vous souhaitez une réponse. Sans adresse, votre message est lu quand même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo, serve solo se vuoi una risposta. Se lo lasci vuoto, il messaggio viene letto lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。返信が必要な場合だけ入力してください。空欄でもメッセージは読まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항으로, 답장을 원할 때만 필요합니다. 비워 두어도 메시지는 읽힙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel, alleen nodig als je antwoord wilt. Leeg gelaten wordt je bericht nog steeds gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalnie, potrzebne tylko wtedy, gdy chcesz odpowiedź. Puste pole nie przeszkadza — wiadomość i tak zostanie przeczytana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional, só é necessário se você quiser uma resposta. Em branco, sua mensagem é lida do mesmo jeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно, нужно только если вы хотите получить ответ. Без адреса сообщение всё равно будет прочитано."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valfritt, behövs bara om du vill ha svar. Lämnas det tomt läses ditt meddelande ändå."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteğe bağlı, yalnızca yanıt istiyorsan gerekir. Boş bırakırsan mesajın yine de okunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选，只有希望收到回复时才需要填写。留空也一样会读到你的消息。"
          }
        }
      }
    },
    "Optional. The tab your message is about, so it's clear where to look." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Der Tab, um den es geht, damit klar ist, wo zu suchen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. La pestaña a la que se refiere tu mensaje, para saber dónde mirar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. L’onglet concerné par votre message, pour savoir où chercher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. La scheda a cui si riferisce il messaggio, così è chiaro dove guardare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。メッセージが関係するタブ。どこを見ればよいかがはっきりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항. 메시지와 관련된 탭이며, 어디를 봐야 할지 분명해집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Het tabblad waar je bericht over gaat, zodat duidelijk is waar te kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalnie. Karta, której dotyczy wiadomość, żeby wiadomo było, gdzie szukać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. A aba a que sua mensagem se refere, para saber onde procurar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
