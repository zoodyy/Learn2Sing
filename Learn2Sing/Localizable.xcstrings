    "Line your singing up with the notes, then tap Done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringe deinen Gesang mit den Noten in Deckung und tippe dann auf „Fertig“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinea tu canto con las notas y luego toca «Listo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alignez votre chant sur les notes, puis touchez « Terminé »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
