        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクササイズタブでお気に入りに印を付ける"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습 탭에서 즐겨찾기 표시"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorieten markeren op tabblad Oefeningen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznaczaj ulubione na karcie Ćwiczenia"
          }
        },
        "pt-BR" : {
