      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط لقراءة هذا الدرس. علامة الاختيار تعني أنك حددته بالفعل كمكتمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe darauf, um diese Lektion zu lesen. Ein Häkchen bedeutet, dass du sie bereits als abgeschlossen markiert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
