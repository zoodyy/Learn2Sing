        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 탭의 즐겨찾기, 루틴, 최근 재생 목록을 지웁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leeg de favorieten, routines en de lijst met recent gespeelde oefeningen op het tabblad Start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczyść ulubione, rutyny i listę ostatnio odtwarzanych na karcie Start."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpe os favoritos, as rotinas e a lista de recentes da aba Início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистите избранное, программы и список недавних на вкладке «Главная»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rensa favoriter, rutiner och listan över senast spelade på fliken Hem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa sekmesindeki favorileri, rutinleri ve son kullanılanlar listesini temizleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清空“首页”标签的收藏、训练组和最近播放列表。"
          }
        }
      }
    },
    "Clears the username you chose and deletes your public profile, so the name is free for someone else to take. Your device ID and your exercises are kept." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح اسم المستخدم الذي اخترته ويحذف ملفك الشخصي العام، ليصبح الاسم متاحًا لغيرك. يبقى معرّف جهازك وتمارينك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den von dir gewählten Benutzernamen und dein öffentliches Profil, sodass der Name für jemand anderen frei wird. Deine Geräte-ID und deine Übungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra el nombre de usuario que elegiste y elimina tu perfil público, de modo que el nombre queda libre para otra persona. Tu ID del dispositivo y tus ejercicios se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface le nom d’utilisateur que vous avez choisi et supprime votre profil public, de sorte que le nom redevient libre pour quelqu’un d’autre. Votre identifiant de l’appareil et vos exercices sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella il nome utente che hai scelto ed elimina il tuo profilo pubblico, così il nome torna libero per qualcun altro. L’ID dispositivo e i tuoi esercizi vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定したユーザー名を消去し、公開プロフィールを削除します。その名前は他の人が使えるようになります。デバイスIDとエクササイズは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 정한 사용자 이름을 지우고 공개 프로필을 삭제하여 그 이름을 다른 사람이 쓸 수 있게 합니다. 기기 ID와 연습은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wist de gebruikersnaam die je koos en verwijdert je openbare profiel, zodat de naam vrijkomt voor iemand anders. Je apparaat-ID en je oefeningen blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czyści wybraną przez ciebie nazwę użytkownika i usuwa twój profil publiczny, więc nazwa staje się wolna dla kogoś innego. Identyfikator urządzenia i twoje ćwiczenia pozostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpa o nome de usuário que você escolheu e exclui seu perfil público, deixando o nome livre para outra pessoa. Seu ID do dispositivo e seus exercícios são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очищает выбранное вами имя пользователя и удаляет ваш публичный профиль, так что имя освобождается для кого-то другого. Идентификатор устройства и упражнения остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rensar användarnamnet du valde och raderar din offentliga profil, så att namnet blir ledigt för någon annan. Ditt enhets-ID och dina övningar behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğiniz kullanıcı adını temizler ve herkese açık profilinizi siler, böylece ad başkası için serbest kalır. Cihaz kimliğiniz ve egzersizleriniz kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除你设置的用户名并删除你的公开资料，这个名字随之空出来供其他人使用。设备 ID 和练习会保留。"
          }
        }
      }
    },
    "Clears your vocal range, including the custom lowest and highest notes, and puts the target window back to the whole note." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح مداك الصوتي، بما في ذلك أخفض وأعلى نغمة مخصصتين، ويعيد النافذة المستهدفة إلى النغمة كاملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht deinen Stimmumfang samt den eigenen tiefsten und höchsten Noten und setzt das Zielfenster wieder auf die ganze Note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra tu tesitura, incluidas las notas más grave y más aguda personalizadas, y devuelve la ventana objetivo a la nota entera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface votre tessiture, y compris les notes la plus grave et la plus aiguë personnalisées, et remet la fenêtre cible sur la note entière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella la tua estensione vocale, comprese le note più bassa e più alta personalizzate, e riporta la finestra target all’intera nota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声域を、カスタムの最低音と最高音を含めて消去し、ターゲット範囲を音符全体に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 지정한 최저음과 최고음을 포함해 음역대를 지우고, 목표 범위를 음표 전체로 되돌립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wist je stembereik, inclusief de eigen laagste en hoogste noot, en zet het doelvenster terug op de hele noot."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czyści twoją skalę głosu wraz z własnymi najniższą i najwyższą nutą i przywraca okno docelowe do całej nuty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpa sua extensão vocal, incluindo as notas mais grave e mais aguda personalizadas, e devolve a janela alvo à nota inteira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очищает ваш диапазон голоса, включая собственные самую низкую и самую высокую ноты, и возвращает целевое окно ко всей ноте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rensar ditt röstomfång, inklusive de egna lägsta och högsta tonerna, och återställer målfönstret till hela noten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses aralığınızı, özel en pes ve en tiz notalar dahil temizler ve hedef pencereyi tüm notaya geri döndürür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除你的音域，包括自定的最低音和最高音，并将目标范围恢复为整个音符。"
          }
        }
      }
    },
    "Climb the scale step by step and come back down in bigger skips. Keep the top note as easy as the bottom one." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اصعد السلم خطوة بخطوة وعُد إلى الأسفل بقفزات أكبر. اجعل النغمة العليا سهلة مثل السفلى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steig die Tonleiter Schritt für Schritt hinauf und komm in größeren Sprüngen wieder herunter. Halte den obersten Ton so leicht wie den untersten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube la escala paso a paso y vuelve a bajar con saltos más grandes. Haz que la nota más alta sea tan fácil como la más baja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montez la gamme degré par degré et redescendez par sauts plus grands. Gardez la note du haut aussi facile que celle du bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sali la scala grado per grado e riscendi con salti più ampi. Mantieni la nota più alta facile quanto quella più bassa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音階を一歩ずつ上がり、大きめの跳躍で下りてきます。最高音も最低音と同じくらい楽に出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음계를 한 음씩 올라간 뒤 더 큰 도약으로 내려오세요. 가장 높은 음도 가장 낮은 음만큼 편하게 내세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klim stap voor stap de toonladder op en kom in grotere sprongen weer naar beneden. Houd de hoogste noot net zo makkelijk als de laagste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wchodź po gamie krok po kroku i schodź większymi skokami. Najwyższy dźwięk ma przychodzić tak łatwo jak najniższy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suba a escala passo a passo e volte descendo em saltos maiores. Mantenha a nota mais aguda tão fácil quanto a mais grave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимайтесь по гамме шаг за шагом и спускайтесь более широкими скачками. Верхняя нота должна даваться так же легко, как нижняя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klättra uppför skalan steg för steg och kom ner igen i större hopp. Håll den översta tonen lika lätt som den nedersta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diziyi adım adım çıkın ve daha büyük atlamalarla geri inin. En üst notayı en alttaki kadar rahat tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿音阶一级一级向上，再用较大的跳进回到下面。最高音要和最低音一样轻松。"
          }
        }
      }
    },
