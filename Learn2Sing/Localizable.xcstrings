    "The whole exercise with the pitch you sang drawn over it. Drag to move around, pinch to zoom." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التمرين كاملًا مع درجة الصوت التي غنيتها مرسومة فوقه. اسحب للتنقل، وقرّب أو بعّد بإصبعين للتكبير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ganze Übung mit der von dir gesungenen Tonhöhe darüber gezeichnet. Ziehen zum Verschieben, Zusammenziehen zum Zoomen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ejercicio entero con el tono que cantaste dibujado encima. Arrastra para moverte, pellizca para acercar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exercice entier avec la hauteur que vous avez chantée tracée par-dessus. Faites glisser pour vous déplacer, pincez pour zoomer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intero esercizio con l’intonazione che hai cantato disegnata sopra. Trascina per spostarti, pizzica per ingrandire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクササイズ全体に、あなたが歌った音程が重ねて描かれています。ドラッグで移動、ピンチで拡大縮小できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습 전체 위에 당신이 부른 음정이 겹쳐 그려집니다. 드래그로 이동하고 손가락을 모아 확대합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hele oefening met de toonhoogte die je zong eroverheen getekend. Sleep om te bewegen, knijp om te zoomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Całe ćwiczenie z narysowaną na wierzchu wysokością twojego głosu. Przeciągaj, aby się poruszać, szczypnij, aby przybliżyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O exercício inteiro com a altura que você cantou desenhada por cima. Arraste para se mover, use a pinça para ampliar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё упражнение целиком с наложенной линией высоты вашего голоса. Тяните, чтобы перемещаться, сводите пальцы, чтобы приблизить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hela övningen med tonhöjden du sjöng ritad ovanpå. Dra för att flytta dig, nyp för att zooma."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söylediğiniz perde üzerine çizilmiş hâliyle egzersizin tamamı. Gezinmek için sürükleyin, yakınlaştırmak için parmaklarınızı kıstırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整个练习，上面叠加着你演唱的音高。拖动可平移，捏合可缩放。"
          }
        }
      }
    },
