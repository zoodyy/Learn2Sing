          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come appare la tua immagine a tutti gli altri. Toccala per spostarla e ingrandirla."
          }
        },
        "ja" : {
          "stringUnit" : {
