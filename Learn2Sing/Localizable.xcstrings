    "Turns the number in the field from plus to minus and back, since the number pad has no minus key." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحوّل الرقم في الحقل من موجب إلى سالب والعكس، لأن لوحة الأرقام لا تحتوي على مفتاح الطرح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht die Zahl im Feld von plus zu minus und zurück, da der Zahlenblock keine Minustaste hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el número del campo de más a menos y viceversa, ya que el teclado numérico no tiene tecla de menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait passer le nombre du champ de plus à moins et inversement, le pavé numérique n’ayant pas de touche moins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma il numero nel campo da più a meno e viceversa, dato che il tastierino numerico non ha il tasto meno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンキーにはマイナスキーがないため、入力欄の数値をプラスとマイナスで切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숫자 키패드에는 마이너스 키가 없어서, 입력란의 숫자를 플러스와 마이너스로 바꿉니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verandert het getal in het veld van plus naar min en terug, omdat het cijfertoetsenbord geen minteken heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia liczbę w polu z plus na minus i z powrotem, bo klawiatura numeryczna nie ma klawisza minus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muda o número do campo de mais para menos e de volta, já que o teclado numérico não tem tecla de menos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет число в поле с плюса на минус и обратно, поскольку на цифровой клавиатуре нет клавиши минуса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Växlar talet i fältet mellan plus och minus, eftersom sifferknappsatsen saknar minustecken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alandaki sayıyı artıdan eksiye ve tersine çevirir; sayı tuş takımında eksi tuşu yoktur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把输入框里的数字在正负之间切换，因为数字键盘没有减号键。"
          }
        }
      }
    },
