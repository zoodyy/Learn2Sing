    "Widen your nasal cavities and envision the sound projecting into the nose and forehead." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weite die Nasenhöhlen und stell dir vor, wie der Klang in Nase und Stirn strömt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensancha las fosas nasales e imagina que el sonido se proyecta hacia la nariz y la frente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élargissez vos cavités nasales et imaginez le son se projeter vers le nez et le front."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allarga le cavità nasali e immagina il suono proiettarsi verso naso e fronte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼻腔を広げ、音が鼻と額へ向かって響いていくのをイメージします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비강을 넓히고 소리가 코와 이마 쪽으로 퍼져 나가는 것을 상상하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijd je neusholtes en stel je voor dat het geluid naar je neus en voorhoofd wordt geprojecteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poszerz jamy nosowe i wyobraź sobie, że dźwięk kieruje się do nosa i czoła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alargue as cavidades nasais e imagine o som se projetando para o nariz e a testa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширьте носовые полости и представьте, что звук направляется в нос и лоб."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidga näshålorna och föreställ dig att ljudet projiceras upp mot näsa och panna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burun boşluklarınızı genişletin ve sesin buruna ve alna doğru yayıldığını hayal edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扩张鼻腔，并想象声音投射到鼻子和额头。"
          }
        }
      }
    },
