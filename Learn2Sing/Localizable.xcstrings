          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропускает это упражнение и переходит к следующему в очереди."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppar över den här övningen och går vidare till nästa i kön."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu egzersizi söylemeden geçer ve sıradaki egzersize gider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳过这个练习，直接进入队列中的下一个。"
          }
        }
      }
    },
    "Leaves this lesson for later and opens the next one." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤجل هذا الدرس إلى وقت لاحق ويفتح الدرس التالي."
          }
        },
        "de" : {
