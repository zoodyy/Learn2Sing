    "Scroll the grid around without changing anything." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّك الشبكة دون تغيير أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt das Raster, ohne etwas zu verändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza la cuadrícula sin cambiar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait défiler la grille sans rien modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la griglia senza cambiare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も変えずにグリッドをスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 바꾸지 않고 격자를 움직입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschuift het raster zonder iets te veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewija siatkę, niczego nie zmieniając."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a grade sem alterar nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокручивает сетку, ничего не меняя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar rutnätet utan att ändra något."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir şeyi değiştirmeden ızgarayı kaydırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只移动网格，不改变任何内容。"
          }
        }
      }
    },
    "Scrolls the screen up and down so the notes being sung stay in the middle. Off, the whole exercise is shown at once." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمرّر الشاشة للأعلى وللأسفل لتبقى النغمات التي تُغنّى في المنتصف. عند إيقافه يُعرض التمرين كله دفعة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollt den Bildschirm auf und ab, damit die gesungenen Noten in der Mitte bleiben. Aus wird die ganze Übung auf einmal gezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza la pantalla arriba y abajo para que las notas que se cantan queden en el centro. Desactivado, se muestra el ejercicio entero de una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait défiler l’écran de haut en bas pour garder les notes chantées au centre. Désactivé, l’exercice entier est affiché d’un coup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa scorrere lo schermo su e giù perché le note cantate restino al centro. Se disattivato, l’esercizio intero è mostrato tutto insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌っている音符が中央に来るように画面を上下にスクロールします。オフにすると、エクササイズ全体が一度に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부르고 있는 음이 가운데에 오도록 화면을 위아래로 스크롤합니다. 끄면 연습 전체가 한 번에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolt het scherm op en neer zodat de gezongen noten in het midden blijven. Uit toont de hele oefening in één keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewija ekran w górę i w dół, aby śpiewane nuty zostawały pośrodku. Wyłączone pokazuje całe ćwiczenie naraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rola a tela para cima e para baixo para que as notas cantadas fiquem no meio. Desligado, o exercício inteiro é mostrado de uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокручивает экран вверх и вниз, чтобы поющиеся ноты оставались посередине. Если выключено, всё упражнение показано целиком."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rullar skärmen upp och ner så att tonerna som sjungs hålls i mitten. Av visas hela övningen på en gång."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söylenen notalar ortada kalsın diye ekranı yukarı aşağı kaydırır. Kapalıyken egzersizin tamamı bir arada gösterilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下滚动画面，让正在演唱的音符保持在中间。关闭时会一次显示整个练习。"
          }
        }
      }
    },
