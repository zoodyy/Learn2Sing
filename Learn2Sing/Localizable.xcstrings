    "Starts listening. Sing the note asked for and hold it until the ring has gone all the way round." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnt zuzuhören. Singe den verlangten Ton und halte ihn, bis der Ring einmal ganz herum ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza a escuchar. Canta la nota que se pide y mantenla hasta que el anillo dé la vuelta entera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commence à écouter. Chantez la note demandée et tenez-la jusqu’à ce que l’anneau ait fait tout le tour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia ad ascoltare. Canta la nota richiesta e tienila finché l’anello non ha fatto tutto il giro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聞き取りを始めます。求められた音を歌い、リングが一周するまで伸ばしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣기를 시작합니다. 요청된 음을 부르고 링이 한 바퀴 돌 때까지 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begint te luisteren. Zing de gevraagde noot en houd hem aan tot de ring helemaal rond is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaczyna słuchać. Zaśpiewaj żądany dźwięk i trzymaj go, aż pierścień obiegnie całe koło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começa a escutar. Cante a nota pedida e sustente até o anel dar a volta inteira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинает слушать. Спойте нужную ноту и держите её, пока кольцо не замкнётся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börjar lyssna. Sjung tonen som efterfrågas och håll den tills ringen gått hela varvet runt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinlemeye başlar. İstenen notayı söyleyin ve halka tamamen dolana kadar tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始聆听。唱出要求的音并保持，直到圆环转满一圈。"
          }
        }
      }
    },
