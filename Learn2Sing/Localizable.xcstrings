      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسم المعروض بجانب التمارين التي تشاركها. لا يمكن لمستخدمَين أن يحملا الاسم نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name, der neben den Übungen steht, die du teilst. Zwei Nutzer können nicht denselben haben."
          }
        },
        "es" : {
