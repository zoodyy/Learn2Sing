          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa sekmesindeki “Sizin için yeni” kategorisinin kaç egzersiz gösterdiği, en fazla 25. Bunlar topluluğun seviyenize en yakın en popüler egzersizleridir."
