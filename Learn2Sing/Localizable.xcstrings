    "Instruments, playback and recording devices, and the microphone delay used for scoring." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instrumente, Wiedergabe- und Aufnahmegeräte sowie die Mikrofonverzögerung für die Bewertung."
