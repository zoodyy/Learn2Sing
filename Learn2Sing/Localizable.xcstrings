        }
      }
    },
    "How long do you want to sing?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange möchtest du singen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuánto tiempo quieres cantar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de temps voulez-vous chanter ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo vuoi cantare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どれくらい歌いますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얼마나 노래하고 싶으세요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang wil je zingen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak długo chcesz śpiewać?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por quanto tempo você quer cantar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько времени хотите петь?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur länge vill du sjunga?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne kadar süre şarkı söylemek istiyorsunuz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你想唱多久？"
          }
        }
      }
    },
    "How long you mean to practise a day. The Home tab's “Recommended” category suggests exercises adding up to at least this long — favouring the whitelisted ones you haven't practised in the longest, pitched at your skill level — and a day of the Home tab's “Time Spent Singing” is filled in and ticked once you have practised this much." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange du am Tag üben möchtest. Die Kategorie „Empfohlen“ im Start-Tab schlägt Übungen vor, die zusammen mindestens so lange dauern — bevorzugt die zugelassenen, die du am längsten nicht geübt hast, abgestimmt auf dein Niveau — und ein Tag in „Gesungene Zeit“ im Start-Tab wird ausgefüllt und bekommt einen Haken, sobald du so lange geübt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo quieres practicar al día. La categoría «Recomendado» de la pestaña Inicio sugiere ejercicios que sumen al menos ese tiempo —dando preferencia a los permitidos que llevas más tiempo sin practicar, ajustados a tu nivel— y un día de «Tiempo cantado» de la pestaña Inicio se rellena y recibe una marca en cuanto has practicado ese tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de temps vous comptez travailler par jour. La catégorie « Recommandé » de l’onglet Accueil propose des exercices dont la durée totale atteint au moins ce temps — en privilégiant les exercices autorisés que vous n’avez pas travaillés depuis le plus longtemps, adaptés à votre niveau — et un jour de « Temps de chant » de l’onglet Accueil se remplit et reçoit une coche dès que vous avez travaillé aussi longtemps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo vuoi esercitarti al giorno. La categoria “Consigliati” della scheda Home propone esercizi che insieme durano almeno altrettanto — prediligendo quelli ammessi che non pratichi da più tempo, calibrati sul tuo livello — e un giorno di “Tempo cantato” nella scheda Home si riempie e riceve un segno di spunta quando ti sei esercitato per questo tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日にどれくらい練習するかです。ホームタブの「おすすめ」カテゴリは、合計でこの時間以上になるエクササイズを提案します（対象のエクササイズのうち最も長く練習していないものを優先し、あなたのレベルに合わせて選びます）。ホームタブの「歌った時間」の各日は、この時間だけ練習するとぬりつぶされ、チェックマークが付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 얼마나 연습할지입니다. 홈 탭의 “추천” 카테고리는 합쳐서 최소 이만큼 걸리는 연습을 제안하며(허용된 연습 중 가장 오래 연습하지 않은 것을 우선하고, 나의 레벨에 맞춰 고릅니다), 홈 탭 “노래한 시간”의 하루는 이만큼 연습하면 색이 채워지고 체크 표시가 붙습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang je per dag wilt oefenen. De categorie ‘Aanbevolen’ op het tabblad Start stelt oefeningen voor die samen minstens zo lang duren — met voorrang voor de toegestane oefeningen die je het langst niet hebt geoefend, afgestemd op je niveau — en een dag in ‘Gezongen tijd’ op het tabblad Start wordt ingekleurd en krijgt een vinkje zodra je zo lang hebt geoefend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile czasu dziennie chcesz ćwiczyć. Kategoria „Polecane” na karcie Start proponuje ćwiczenia, które razem trwają co najmniej tyle — preferując te dozwolone, których najdłużej nie ćwiczyłeś, dobrane do twojego poziomu — a dzień w kategorii „Czas śpiewania” na karcie Start zostaje wypełniony i oznaczony haczykiem, gdy tyle poćwiczysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo você pretende praticar por dia. A categoria “Recomendado” da aba Início sugere exercícios que somem pelo menos esse tempo — preferindo os permitidos que você não pratica há mais tempo, ajustados ao seu nível — e um dia de “Tempo cantado” da aba Início é preenchido e ganha um tique assim que você praticar tudo isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько времени в день вы собираетесь заниматься. Категория «Рекомендуемые» на вкладке «Главная» предлагает упражнения, которые в сумме длятся не меньше этого времени — предпочтение отдаётся разрешённым, которыми вы дольше всего не занимались, подобранным под ваш уровень, — а день в разделе «Время пения» на вкладке «Главная» закрашивается и отмечается галочкой, как только вы позанимались столько."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur länge du tänker öva per dag. Kategorin ”Rekommenderat” på fliken Hem föreslår övningar som tillsammans räcker minst så länge — den föredrar de tillåtna övningar du övat på för längst sedan, anpassade till din nivå — och en dag i ”Sångtid” på fliken Hem fylls i och får en bock så snart du har övat så länge."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde ne kadar çalışmayı düşündüğünüz. Ana Sayfa sekmesindeki “Önerilen” kategorisi, toplamda en az bu kadar süren egzersizler önerir — en uzun süredir çalışmadığınız, izin verilen egzersizleri seviyenize göre öne çıkararak — ve Ana Sayfa sekmesindeki “Şarkı söyleme süresi”nde bir gün, bu kadar çalıştığınızda dolar ve onay işareti alır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你打算每天练习多长时间。“首页”标签中的“推荐”类别会建议加起来至少这么长的练习——优先挑选你最久没有练习过的已列入练习，并按你的水平来选——“首页”标签的“歌唱时长”中，某一天练满这么久后就会被填满并打上对勾。"
          }
        }
      }
    },
    "How long your microphone takes to hear you. Your scores are worked out with this taken off, and you can change it in Settings under Audio." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange dein Mikrofon braucht, um dich zu hören. Deine Bewertungen werden abzüglich dieses Werts berechnet, und du kannst ihn in den Einstellungen unter Audio ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tarda tu micrófono en oírte. Tus puntuaciones se calculan restando este valor, y puedes cambiarlo en Ajustes, en Audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps que met votre micro à vous entendre. Vos scores sont calculés en retranchant cette valeur, que vous pouvez modifier dans Réglages, sous Audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo impiega il microfono a sentirti. I punteggi vengono calcolati sottraendo questo valore, che puoi cambiare in Impostazioni, sotto Audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクがあなたの声を捉えるまでの時間です。スコアはこの分を差し引いて計算され、設定のオーディオで変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크가 당신의 소리를 듣기까지 걸리는 시간입니다. 점수는 이 값을 뺀 뒤 계산되며, 설정의 오디오에서 바꿀 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang je microfoon erover doet om je te horen. Je scores worden berekend met deze waarde eraf, en je kunt hem wijzigen in Instellingen onder Audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile czasu potrzebuje mikrofon, żeby cię usłyszeć. Wyniki liczone są po odjęciu tej wartości, a zmienisz ją w Ustawieniach w sekcji Dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo o seu microfone leva para ouvir você. Suas pontuações são calculadas descontando este valor, que você pode mudar em Ajustes, em Áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько времени микрофону нужно, чтобы вас услышать. Оценки считаются с вычетом этой задержки, а изменить её можно в настройках, в разделе «Аудио»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur lång tid din mikrofon behöver för att höra dig. Dina poäng räknas ut med det här avdraget, och du kan ändra det i Inställningar under Ljud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonunuzun sizi duyması ne kadar sürüyor. Puanlarınız bu değer düşülerek hesaplanır ve Ayarlar’daki Ses bölümünden değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风听到你的声音所需的时间。评分会扣掉这段延迟，你可以在“设置”的音频里修改。"
          }
        }
      }
    },
