    "Where this lesson comes from, and the license it is shared under. Tap a link to open it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصدر هذا الدرس والترخيص الذي يُشارَك بموجبه. اضغط على رابط لفتحه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woher diese Lektion stammt und unter welcher Lizenz sie geteilt wird. Tippe auf einen Link, um ihn zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dónde procede esta lección y la licencia con la que se comparte. Toca un enlace para abrirlo."
