    "What you would like to say. The more exactly you describe it, the more can be done about it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما تريد قوله. كلما وصفته بدقة أكبر، أمكن فعل المزيد بشأنه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du sagen möchtest. Je genauer du es beschreibst, desto mehr lässt sich damit anfangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que quieres decir. Cuanto más exacto sea, más se podrá hacer al respecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous souhaitez dire. Plus votre description est précise, plus il sera possible d’agir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello che vuoi dire. Più precisamente lo descrivi, più si potrà fare al riguardo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伝えたい内容です。詳しく書くほど、対応しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하고 싶은 말입니다. 자세히 적을수록 더 많은 조치를 취할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je wilt zeggen. Hoe nauwkeuriger je het beschrijft, hoe meer ermee gedaan kan worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co chcesz powiedzieć. Im dokładniej to opiszesz, tym więcej da się z tym zrobić."
