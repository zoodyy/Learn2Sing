    "Flick the tip of your tongue for each \"L\" and keep your jaw still. Only your tongue should move." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّك طرف لسانك بخفة مع كل «L» وأبقِ فكك ثابتًا. لسانك وحده يجب أن يتحرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnipp für jedes „L“ mit der Zungenspitze und halte den Kiefer still. Nur die Zunge soll sich bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da un toque con la punta de la lengua en cada «L» y mantén la mandíbula quieta. Solo debe moverse la lengua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez un petit coup du bout de la langue pour chaque « L » et gardez la mâchoire immobile. Seule la langue doit bouger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai un colpetto con la punta della lingua per ogni “L” e tieni ferma la mascella. Deve muoversi solo la lingua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「L」のたびに舌先を軽くはじき、あごは動かさないようにします。動くのは舌だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“L”마다 혀끝을 가볍게 튕기고 턱은 가만히 두세요. 혀만 움직여야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik voor elke ‘L’ met het puntje van je tong en houd je kaak stil. Alleen je tong beweegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy każdym „L” pstryknij czubkiem języka i trzymaj szczękę nieruchomo. Porusza się tylko język."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque rapidamente com a ponta da língua a cada “L” e mantenha o maxilar parado. Só a língua deve se mexer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На каждое «L» делайте лёгкий взмах кончиком языка, а челюсть держите неподвижной. Двигаться должен только язык."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snärta med tungspetsen på varje ”L” och håll käken stilla. Bara tungan ska röra sig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her “L” için dilinizin ucuyla hafifçe vurun ve çenenizi sabit tutun. Yalnızca diliniz hareket etmeli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个“L”都用舌尖轻弹一下，下颌保持不动。只有舌头在动。"
          }
        }
      }
    },
