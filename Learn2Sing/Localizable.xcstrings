        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe je foto er voor iedereen anders uitziet. Tik erop om hem te verschuiven en te zoomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak twoje zdjęcie wygląda dla innych. Dotknij, aby je przesunąć i przybliżyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como sua foto aparece para os outros. Toque nela para movê-la e ampliá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так ваше фото выглядит для всех остальных. Нажмите, чтобы сдвинуть и приблизить его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så här ser din bild ut för alla andra. Tryck på den för att flytta och zooma."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğrafınızın herkese nasıl göründüğü. Taşımak ve yakınlaştırmak için dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别人看到的头像效果。点按可移动和缩放。"
          }
        }
      }
    },
    "How Your Voice Makes Sound" : {
