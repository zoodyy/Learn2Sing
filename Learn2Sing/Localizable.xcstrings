    "Ticks every exercise at once, or clears them all." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt alle Übungen auf einmal aus oder hebt die Auswahl komplett auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca todos los ejercicios de una vez, o los desmarca todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coche tous les exercices d’un coup, ou les décoche tous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona tutti gli esercizi in una volta, o li deseleziona tutti."
          }
