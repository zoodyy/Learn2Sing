    "Think of the scale underneath the skips, so every note lands in tune." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فكّر في السلم الكامن تحت القفزات، حتى تستقر كل نغمة على درجتها الصحيحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denk an die Tonleiter unter den Sprüngen, damit jeder Ton sauber sitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piensa en la escala que hay debajo de los saltos para que cada nota quede afinada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensez à la gamme sous les sauts, pour que chaque note tombe juste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensa alla scala che sta sotto i salti, così ogni nota arriva intonata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳躍の下にある音階を意識すると、どの音も正しい音程に収まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도약 아래에 깔린 음계를 떠올리면 모든 음이 정확한 음정에 자리 잡습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denk aan de toonladder onder de sprongen, zodat elke noot zuiver landt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myśl o gamie ukrytej pod skokami, aby każdy dźwięk trafiał czysto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
