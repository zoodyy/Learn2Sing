        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt eine MP3- oder WAV-Datei mit einem einzelnen Klang hoch, mit dem die Noten gespielt werden."
          }
        },
        "es" : {
          "stringUnit" : {
