    "What you would like to say. The more exactly you describe it, the more can be done about it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du sagen möchtest. Je genauer du es beschreibst, desto mehr lässt sich damit anfangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que quieres decir. Cuanto más exacto sea, más se podrá hacer al respecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous souhaitez dire. Plus votre description est précise, plus il sera possible d’agir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
