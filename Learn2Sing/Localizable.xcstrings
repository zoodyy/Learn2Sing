          }
        }
      }
    },
    "Opens the settings these suggestions are made under: how long you practice a day, and which exercises may be picked." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح الإعدادات التي تُبنى عليها هذه الاقتراحات: المدة التي تتمرّن فيها يوميًا، والتمارين التي يمكن اختيارها."
          }
        },
        "de" : {
