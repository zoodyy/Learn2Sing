    "Finishes with this exercise. Flicking right across the screen does the same." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنهي هذا التمرين. التمرير لليسار عبر الشاشة يفعل الشيء نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet diese Übung. Ein Wischen nach rechts über den Bildschirm tut dasselbe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina con este ejercicio. Deslizar hacia la derecha por la pantalla hace lo mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
