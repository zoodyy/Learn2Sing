    "Aim for the center of each note instead of sliding into it. Hear the next note in your head before you sing it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استهدف مركز كل نغمة بدلًا من الانزلاق إليها. اسمع النغمة التالية في رأسك قبل أن تغنيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triff die Mitte jedes Tons, statt in ihn hineinzurutschen. Hör den nächsten Ton innerlich, bevor du ihn singst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta al centro de cada nota en lugar de deslizarte hacia ella. Escucha la siguiente nota en tu cabeza antes de cantarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visez le centre de chaque note au lieu d’y glisser. Entendez la note suivante dans votre tête avant de la chanter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punta al centro di ogni nota invece di scivolarci dentro. Senti la nota successiva nella tua testa prima di cantarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音にずり上げて入るのではなく、各音の中心をねらいます。次の音を歌う前に頭の中で聴きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음으로 미끄러져 들어가지 말고 각 음의 중심을 겨냥하세요. 다음 음을 부르기 전에 머릿속으로 먼저 들으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mik op het midden van elke noot in plaats van erin te glijden. Hoor de volgende noot in je hoofd voordat je hem zingt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celuj w środek każdego dźwięku, zamiast się do niego podciągać. Usłysz następny dźwięk w głowie, zanim go zaśpiewasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mire no centro de cada nota em vez de deslizar até ela. Ouça a próxima nota na cabeça antes de cantá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попадайте в центр каждой ноты, а не подъезжайте к ней. Слышьте следующую ноту в голове, прежде чем её петь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikta på mitten av varje ton i stället för att glida in i den. Hör nästa ton inom dig innan du sjunger den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notalara kayarak girmek yerine her notanın tam ortasını hedefleyin. Bir sonraki notayı söylemeden önce kafanızda duyun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瞄准每个音的中心，而不是滑进去。唱下一个音之前先在脑中听到它。"
          }
        }
      }
    },
    "All" : {
