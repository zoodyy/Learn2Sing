        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забывает, сколько вы занимались каждый день: очищает «Время пения» на вкладке «Главная»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glömmer hur länge du övat varje dag: tömmer ”Sångtid” på fliken Hem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her gün ne kadar çalıştığınızı unutur: Ana Sayfa sekmesindeki “Şarkı söyleme süresi”ni boşaltır."
