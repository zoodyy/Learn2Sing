          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa wyniki wszystkich ćwiczeń, w tym te pozostałe po ćwiczeniach już usuniętych. Same ćwiczenia pozostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
