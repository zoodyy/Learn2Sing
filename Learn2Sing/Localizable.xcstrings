    "When you’re ready, sing the lowest note you can and hold it steadily for 2 seconds." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du bereit bist, singe den tiefsten Ton, den du kannst, und halte ihn 2 Sekunden lang gleichmäßig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando estés listo, canta la nota más grave que puedas y mantenla de forma estable durante 2 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous êtes prêt, chantez la note la plus grave possible et tenez-la de façon stable pendant 2 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando sei pronto, canta la nota più bassa che riesci e tienila ferma per 2 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができたら、出せる限り低い音を歌い、2秒間まっすぐ伸ばしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비되면 낼 수 있는 가장 낮은 음을 2초 동안 안정적으로 유지하며 부르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zing wanneer je klaar bent de laagste noot die je kunt en houd die 2 seconden stabiel aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy będziesz gotów, zaśpiewaj najniższy dźwięk, jaki potrafisz, i utrzymaj go równo przez 2 sekundy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando estiver pronto, cante a nota mais grave que conseguir e sustente-a por 2 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда будете готовы, спойте самую низкую ноту, которую можете, и держите её ровно 2 секунды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjung din lägsta möjliga ton när du är redo och håll den stadigt i 2 sekunder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır olduğunuzda, çıkarabildiğiniz en pes notayı söyleyin ve 2 saniye boyunca sabit tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备好后，唱出你能发出的最低音，并稳定保持 2 秒。"
          }
        }
      }
    },
