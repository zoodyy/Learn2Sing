    "Copies this exercise into your own library, where you can change it and keep your scores for it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينسخ هذا التمرين إلى مكتبتك، حيث يمكنك تغييره والاحتفاظ بنتائجك فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert diese Übung in deine eigene Bibliothek, wo du sie ändern kannst und deine Ergebnisse dafür behältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia este ejercicio a tu propia biblioteca, donde puedes modificarlo y guardar tus puntuaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie cet exercice dans votre bibliothèque, où vous pouvez le modifier et conserver vos scores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia questo esercizio nella tua libreria, dove puoi modificarlo e conservare i tuoi punteggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエクササイズを自分のライブラリにコピーします。ライブラリでは編集でき、スコアも残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연습을 내 라이브러리로 복사합니다. 거기서 수정할 수 있고 점수도 쌓입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieert deze oefening naar je eigen bibliotheek, waar je hem kunt aanpassen en je scores bewaart."
          }
        },
        "pl" : {
