    "Feel the notes in groups of three, with a slight lean on the first note of each group." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشعر بالنغمات في مجموعات من ثلاث، مع تشديد خفيف على النغمة الأولى في كل مجموعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spüre die Töne in Dreiergruppen, mit einer leichten Betonung auf dem ersten Ton jeder Gruppe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siente las notas en grupos de tres, con un ligero apoyo en la primera nota de cada grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentez les notes par groupes de trois, en appuyant légèrement sur la première de chaque groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senti le note in gruppi di tre, con un leggero appoggio sulla prima nota di ogni gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音を3つずつのまとまりで感じ、各グループの最初の音に少し重みを置きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음을 세 개씩 묶어 느끼고, 각 묶음의 첫 음에 살짝 무게를 두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voel de noten in groepjes van drie, met een lichte nadruk op de eerste noot van elke groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czuj dźwięki w grupach po trzy, z lekkim akcentem na pierwszym dźwięku każdej grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinta as notas em grupos de três, com um leve apoio na primeira nota de cada grupo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ощущайте ноты группами по три, с лёгким акцентом на первой ноте каждой группы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känn tonerna i grupper om tre, med en lätt betoning på den första tonen i varje grupp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notaları üçlü gruplar halinde hissedin ve her grubun ilk notasına hafifçe vurgu yapın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把音符按三个一组来感受，每组的第一个音稍加强调。"
          }
        }
      }
    },
