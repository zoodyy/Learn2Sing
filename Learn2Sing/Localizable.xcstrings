        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você também quer mudar a tela de reprodução para a aparência escura padrão? Suas personalizações serão substituídas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключить экран воспроизведения на стандартное тёмное оформление? Ваши настройки будут заменены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du även byta uppspelningsskärmen till det mörka standardutseendet? Dina anpassningar ersätts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalma ekranını da standart koyu görünüme geçirmek ister misiniz? Özelleştirmeleriniz değiştirilecek."
          }
        },
        "zh-Hans" : {
