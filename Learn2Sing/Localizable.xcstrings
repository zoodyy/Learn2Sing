    "Sing your lowest and highest notes and the app sets them as your custom vocal range above." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singe deinen tiefsten und höchsten Ton – die App trägt sie oben als deinen eigenen Stimmumfang ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta tus notas más grave y más aguda y la app las guarda arriba como tu tesitura personalizada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chantez vos notes la plus grave et la plus aiguë : l’app les enregistre ci-dessus comme votre tessiture personnalisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta la tua nota più bassa e la più alta: l’app le imposta sopra come la tua estensione personalizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最低音と最高音を歌うと、アプリが上のカスタム声域に設定します。"
