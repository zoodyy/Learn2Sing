        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что вы хотите сказать. Чем точнее опишете, тем больше можно будет с этим сделать."
          }
        },
        "sv" : {
          "stringUnit" : {
