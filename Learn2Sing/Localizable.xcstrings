        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui todos os exercícios que você baixou da aba Comunidade, com seu padrão MIDI e suas pontuações. Seus próprios exercícios e os que vêm com o app são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет каждое упражнение, скачанное из вкладки «Сообщество», вместе с его MIDI-рисунком и оценками. Ваши собственные и встроенные упражнения остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderar varje övning du laddat ner från fliken Community, med dess MIDI-mönster och poäng. Dina egna övningar och de som följde med appen behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topluluk sekmesinden indirdiğiniz her egzersizi, MIDI deseni ve puanlarıyla birlikte siler. Kendi egzersizleriniz ve uygulamayla gelenler kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除你从“社区”标签下载的每个练习，连同其 MIDI 音型和得分。你自己的练习和应用自带的练习会保留。"
          }
        }
