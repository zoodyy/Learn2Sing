    "Each repetition is played this many BPM faster than the one before it. A negative value slows it down." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Wiederholung wird um so viele BPM schneller gespielt als die vorige. Ein negativer Wert verlangsamt sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repetición se toca estos BPM más rápido que la anterior. Un valor negativo la ralentiza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque répétition est jouée ce nombre de BPM plus vite que la précédente. Une valeur négative ralentit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni ripetizione viene suonata questi BPM più veloce della precedente. Un valore negativo rallenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各繰り返しが、前の繰り返しよりこの BPM だけ速く再生されます。マイナスにすると遅くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 반복이 앞 반복보다 이만큼의 BPM 빠르게 재생됩니다. 음수로 하면 느려집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke herhaling wordt dit aantal BPM sneller gespeeld dan de vorige. Een negatieve waarde vertraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde powtórzenie jest grane o tyle BPM szybciej niż poprzednie. Wartość ujemna spowalnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repetição é tocada estes BPM mais rápido que a anterior. Um valor negativo desacelera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый повтор играется на столько BPM быстрее предыдущего. Отрицательное значение замедляет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje repetition spelas så här många BPM snabbare än den föregående. Ett negativt värde saktar ner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her tekrar bir öncekinden bu kadar BPM daha hızlı çalınır. Negatif değer yavaşlatır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次重复都比上一次快这么多 BPM。设为负数则变慢。"
          }
        }
      }
    },
    "Each repetition starts this many semitones above the one before it. A negative value works downwards." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Wiederholung beginnt so viele Halbtöne über der vorigen. Ein negativer Wert geht abwärts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repetición empieza estos semitonos por encima de la anterior. Un valor negativo va hacia abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque répétition commence ce nombre de demi-tons au-dessus de la précédente. Une valeur négative descend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni ripetizione inizia questi semitoni sopra la precedente. Un valore negativo scende."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各繰り返しが、前の繰り返しよりこの半音数だけ高く始まります。マイナスにすると下がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 반복이 앞 반복보다 이만큼의 반음 위에서 시작합니다. 음수로 하면 아래로 내려갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke herhaling begint dit aantal halve tonen boven de vorige. Een negatieve waarde gaat omlaag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde powtórzenie zaczyna się o tyle półtonów wyżej niż poprzednie. Wartość ujemna prowadzi w dół."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repetição começa estes semitons acima da anterior. Um valor negativo desce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый повтор начинается на столько полутонов выше предыдущего. Отрицательное значение идёт вниз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje repetition börjar så här många halvtoner över den föregående. Ett negativt värde går nedåt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her tekrar bir öncekinden bu kadar yarım ses yukarıda başlar. Negatif değer aşağı doğru gider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次重复都比上一次高这么多个半音。设为负数则向下走。"
          }
        }
      }
    },
