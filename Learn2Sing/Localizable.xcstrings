    "Your favourite exercises, in the order the Home tab shows them. Drag by the handle on the right to rearrange them." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Lieblingsübungen, in der Reihenfolge, in der der Start-Tab sie zeigt. Ziehe sie am Griff rechts, um sie umzusortieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus ejercicios favoritos, en el orden en que los muestra la pestaña Inicio. Arrástralos por el asa de la derecha para reordenarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos exercices favoris, dans l’ordre où l’onglet Accueil les affiche. Faites-les glisser par la poignée à droite pour les réorganiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
