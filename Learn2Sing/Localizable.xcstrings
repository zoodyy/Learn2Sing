        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 사람에게 보이는 당신의 사진입니다. 탭하면 위치와 확대를 조정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
