        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repetição começa estes semitons acima da anterior. Um valor negativo desce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый повтор начинается на столько полутонов выше предыдущего. Отрицательное значение идёт вниз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
