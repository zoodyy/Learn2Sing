    "Sends your message straight to the developer. It stays greyed out until the type and the message are filled in." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt deine Nachricht direkt an den Entwickler. Der Knopf bleibt grau, bis Art und Nachricht ausgefüllt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía tu mensaje directamente al desarrollador. Sigue en gris hasta que rellenes el tipo y el mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie votre message directement au développeur. Le bouton reste grisé tant que le type et le message ne sont pas remplis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia il tuo messaggio direttamente allo sviluppatore. Resta in grigio finché tipo e messaggio non sono compilati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージを開発者に直接送ります。種類と本文が入力されるまでボタンは灰色のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 개발자에게 바로 보냅니다. 유형과 내용을 채우기 전까지는 흐리게 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuurt je bericht rechtstreeks naar de ontwikkelaar. De knop blijft grijs totdat het type en het bericht zijn ingevuld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła twoją wiadomość prosto do dewelopera. Przycisk pozostaje wyszarzony, dopóki nie wypełnisz typu i treści."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia sua mensagem direto ao desenvolvedor. Fica esmaecido até que o tipo e a mensagem estejam preenchidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет ваше сообщение прямо разработчику. Кнопка остаётся серой, пока не заполнены тип и текст сообщения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickar ditt meddelande direkt till utvecklaren. Knappen är nedtonad tills typ och meddelande är ifyllda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajınızı doğrudan geliştiriciye gönderir. Tür ve mesaj doldurulana kadar soluk kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你的消息直接发给开发者。在填好类型和内容之前，按钮保持灰色。"
          }
        }
      }
    },
