          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los ejercicios que descargaste de la pestaña Comunidad, con su patrón MIDI y sus puntuaciones. Tus propios ejercicios y los que vienen con la app se conservan."
