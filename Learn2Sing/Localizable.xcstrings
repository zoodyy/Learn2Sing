            "value" : "Unas palabras sobre ti, que aparecen arriba en tu perfil de la pestaña Comunidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques mots sur vous, affichés en haut de votre profil dans l’onglet Communauté."
