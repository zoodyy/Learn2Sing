        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dersin kaynağı ve paylaşıldığı lisans. Açmak için bir bağlantıya dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
