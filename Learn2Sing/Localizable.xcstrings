    "Sets the order the exercises come in. “Reverse Order” turns whichever order is picked around." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد ترتيب ظهور التمارين. «عكس الترتيب» يقلب الترتيب المختار أيًا كان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, in welcher Reihenfolge die Übungen stehen. „Umgekehrte Reihenfolge“ dreht die gewählte Sortierung um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define el orden en que aparecen los ejercicios. «Orden inverso» invierte el orden elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit l’ordre des exercices. « Ordre inversé » retourne l’ordre choisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta l’ordine in cui compaiono gli esercizi. “Ordine inverso” capovolge l’ordine scelto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクササイズの並び順を決めます。「逆順」を選ぶと、選んだ順序が反転します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습이 나열되는 순서를 정합니다. “역순”은 선택한 순서를 뒤집습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt de volgorde van de oefeningen. ‘Omgekeerde volgorde’ draait de gekozen volgorde om."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustala kolejność, w jakiej idą ćwiczenia. „Odwrotna kolejność” odwraca wybrany porządek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define a ordem em que os exercícios aparecem. “Ordem inversa” inverte a ordem escolhida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт порядок, в котором идут упражнения. «Обратный порядок» переворачивает выбранный порядок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestämmer ordningen övningarna visas i. ”Omvänd ordning” vänder på den valda ordningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egzersizlerin hangi sırayla geleceğini belirler. “Ters sıra” seçilen sıralamayı tersine çevirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置练习的排列顺序。“倒序”会把所选顺序反过来。"
          }
        }
      }
    },
