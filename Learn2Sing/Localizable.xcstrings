    "Delete your scores, exercises and Home tab lists, or put your settings back to how the app started out." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche deine Punktzahlen, Übungen und Listen im Start-Tab oder setze deine Einstellungen auf den Anfangszustand der App zurück."
