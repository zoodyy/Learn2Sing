        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yukarıdaki egzersizleri en baştan başlayarak arka arkaya söyler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从最上面开始，依次演唱上面的练习。"
          }
        }
      }
    },
