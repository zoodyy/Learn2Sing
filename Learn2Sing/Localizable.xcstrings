        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia questo esercizio senza cantarlo e passa al successivo della coda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエクササイズを歌わずに飛ばして、次のエクササイズへ進みます。"
