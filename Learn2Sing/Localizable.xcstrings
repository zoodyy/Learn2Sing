            "value" : "Favoriten im Übungen-Tab markieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcar favoritos en la pestaña Ejercicios"
          }
        },
        "fr" : {
          "stringUnit" : {
