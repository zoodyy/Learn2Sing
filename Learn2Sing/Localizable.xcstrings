          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ergebnisse für diese Übung im Zeitverlauf. Im oben gewählten Zeitraum wurde nichts gesungen."
          }
        },
        "es" : {
