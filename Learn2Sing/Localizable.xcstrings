          }
        }
      }
    },
    "Writes the ticked exercises to a file and opens the share sheet, where you can send it, copy it, or save it to Files." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt die ausgewählten Übungen in eine Datei und öffnet das Teilen-Menü, wo du sie versenden, kopieren oder in „Dateien“ sichern kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda los ejercicios marcados en un archivo y abre el menú de compartir, desde donde puedes enviarlo, copiarlo o guardarlo en Archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit les exercices cochés dans un fichier et ouvre la feuille de partage, d’où vous pouvez l’envoyer, le copier ou l’enregistrer dans Fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive gli esercizi selezionati in un file e apre il pannello di condivisione, da cui puoi inviarlo, copiarlo o salvarlo in File."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したエクササイズをファイルに書き出し、共有メニューを開きます。そこから送信・コピー・「ファイル」への保存ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 연습을 파일로 저장하고 공유 시트를 엽니다. 거기서 파일을 보내거나 복사하거나 ‘파일’ 앱에 저장할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijft de aangevinkte oefeningen naar een bestand en opent het deelmenu, waar je het kunt versturen, kopiëren of in Bestanden bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje zaznaczone ćwiczenia do pliku i otwiera menu udostępniania, z którego możesz go wysłać, skopiować lub zapisać w Plikach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava os exercícios marcados em um arquivo e abre o menu de compartilhamento, de onde você pode enviá-lo, copiá-lo ou salvá-lo em Arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает отмеченные упражнения в файл и открывает меню «Поделиться», откуда его можно отправить, скопировать или сохранить в «Файлы»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver de markerade övningarna till en fil och öppnar delningsmenyn, där du kan skicka den, kopiera den eller spara den i Filer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretli egzersizleri bir dosyaya yazar ve paylaşım menüsünü açar; oradan dosyayı gönderebilir, kopyalayabilir veya Dosyalar’a kaydedebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
