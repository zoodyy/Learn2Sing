    "Export saves every exercise and its settings to a file. Import merges exercises from a file into your library." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Exportieren werden alle Übungen samt Einstellungen in eine Datei gesichert. Beim Importieren werden Übungen aus einer Datei in deine Bibliothek übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar guarda todos los ejercicios y sus ajustes en un archivo. Importar añade a tu biblioteca los ejercicios de un archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’export enregistre chaque exercice et ses réglages dans un fichier. L’import fusionne les exercices d’un fichier dans votre bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’esportazione salva ogni esercizio e le sue impostazioni in un file. L’importazione unisce alla tua libreria gli esercizi di un file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出しでは、すべてのエクササイズと設定をファイルに保存します。読み込みでは、ファイル内のエクササイズをライブラリに統合します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기는 모든 연습과 설정을 파일로 저장합니다. 가져오기는 파일의 연습을 라이브러리에 병합합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteren bewaart elke oefening met haar instellingen in een bestand. Importeren voegt oefeningen uit een bestand samen met je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksport zapisuje wszystkie ćwiczenia i ich ustawienia do pliku. Import scala ćwiczenia z pliku z twoją biblioteką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar salva todos os exercícios e suas configurações em um arquivo. Importar mescla os exercícios de um arquivo à sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт сохраняет все упражнения и их настройки в файл. Импорт добавляет упражнения из файла в вашу библиотеку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export sparar varje övning och dess inställningar i en fil. Import slår ihop övningar från en fil med ditt bibliotek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa aktarma, her egzersizi ve ayarlarını bir dosyaya kaydeder. İçe aktarma, bir dosyadaki egzersizleri kitaplığınızla birleştirir."
          }
