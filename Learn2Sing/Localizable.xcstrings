        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde ćwiczenie utworzone przez ciebie zostanie usunięte wraz z jego wzorem MIDI i wynikami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os exercícios que você mesmo criou serão excluídos, junto com seu padrão MIDI e suas pontuações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
