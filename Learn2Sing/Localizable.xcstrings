    "You already have a public exercise named \"%@\". Each of your public exercises needs a unique name, so this one stays private." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast bereits eine öffentliche Übung namens „%@“. Jede deiner öffentlichen Übungen braucht einen eindeutigen Namen, deshalb bleibt diese privat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes un ejercicio público llamado «%@». Cada uno de tus ejercicios públicos necesita un nombre único, así que este seguirá siendo privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà un exercice public nommé « %@ ». Chacun de vos exercices publics doit avoir un nom unique : celui-ci reste donc privé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già un esercizio pubblico chiamato “%@”. Ogni tuo esercizio pubblico deve avere un nome unico, quindi questo resta privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに「%@」という名前の公開エクササイズがあります。公開エクササイズの名前はそれぞれ重複できないため、こちらは非公開のままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 “%@”(이)라는 이름의 공개 연습이 있습니다. 공개 연습은 각각 고유한 이름이 필요하므로 이 연습은 비공개로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt al een openbare oefening met de naam ‘%@’. Elk van je openbare oefeningen heeft een unieke naam nodig, dus deze blijft privé."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz już publiczne ćwiczenie o nazwie „%@”. Każde z twoich publicznych ćwiczeń musi mieć unikalną nazwę, więc to pozostanie prywatne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já tem um exercício público chamado “%@”. Cada um dos seus exercícios públicos precisa de um nome único, então este continua privado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас уже есть публичное упражнение с названием «%@». Каждому публичному упражнению нужно уникальное название, поэтому это останется личным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har redan en offentlig övning som heter ”%@”. Var och en av dina offentliga övningar behöver ett unikt namn, så den här förblir privat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten “%@” adlı herkese açık bir egzersiziniz var. Herkese açık egzersizlerinizin her birinin adı benzersiz olmalı; bu yüzden bu egzersiz özel kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已经有一个名为“%@”的公开练习。你的每个公开练习都需要唯一的名称，因此该练习将保持私有。"
          }
        }
      }
    },
