    "Delete the exercises you made or downloaded, and undo your changes to the ones that came with the app." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احذف التمارين التي أنشأتها أو نزّلتها، وتراجع عن تغييراتك على التمارين المرفقة مع التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche die Übungen, die du erstellt oder heruntergeladen hast, und mache deine Änderungen an den mitgelieferten rückgängig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los ejercicios que creaste o descargaste, y deshaz tus cambios en los que vienen con la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez les exercices que vous avez créés ou téléchargés, et annulez vos modifications sur ceux fournis avec l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina gli esercizi che hai creato o scaricato e annulla le tue modifiche a quelli inclusi nell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で作成またはダウンロードしたエクササイズを削除し、アプリに付属するエクササイズへの変更を元に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 만들거나 내려받은 연습을 삭제하고, 앱에 포함된 연습에 가한 변경을 되돌립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder de oefeningen die je zelf maakte of downloadde, en maak je wijzigingen aan de meegeleverde ongedaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń ćwiczenia, które utworzyłeś lub pobrałeś, i cofnij zmiany w tych dołączonych do aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclua os exercícios que você criou ou baixou e desfaça suas alterações nos que vêm com o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалите упражнения, которые вы создали или скачали, и отмените свои изменения во встроенных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radera övningarna du skapat eller laddat ner, och ångra dina ändringar i dem som följde med appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi oluşturduğunuz veya indirdiğiniz egzersizleri silin ve uygulamayla gelenlerde yaptığınız değişiklikleri geri alın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除你创建或下载的练习，并撤销你对应用自带练习所做的更改。"
          }
        }
      }
    },
    "Delete the scores recorded for a single exercise, or wipe them all." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
