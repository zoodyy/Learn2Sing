          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生画面の左側に並ぶ音名（C4、A3 …）の色を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
