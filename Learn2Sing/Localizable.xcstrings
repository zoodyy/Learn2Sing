    "Clears the username you chose. Your device ID and your exercises are kept." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den von dir gewählten Benutzernamen. Deine Geräte-ID und deine Übungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra el nombre de usuario que elegiste. Tu ID del dispositivo y tus ejercicios se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface le nom d’utilisateur que vous avez choisi. Votre identifiant de l’appareil et vos exercices sont conservés."
