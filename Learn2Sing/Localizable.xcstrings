            "value" : "Svuota l’elenco “Preferiti” della scheda Home. Gli esercizi al suo interno vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームタブの「お気に入り」リストを空にします。その中のエクササイズは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 탭의 “즐겨찾기” 목록을 비웁니다. 목록에 있던 연습은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt de lijst ‘Favorieten’ op het tabblad Start leeg. De oefeningen erin blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opróżnia listę „Ulubione” na karcie Start. Ćwiczenia z niej pozostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esvazia a lista “Favoritos” da aba Início. Os exercícios nela são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
