        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reglerna för att använda appen och dess community. Ett tryck lämnar appen och öppnar dem i din webbläsare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın ve topluluğunun kullanım kuralları. Dokunduğunuzda uygulamadan çıkılır ve kurallar tarayıcınızda açılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
